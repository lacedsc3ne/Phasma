<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Installer.Pages.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Installer.Pages"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Installer"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ManagerViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerPage"
      Scrollable="True"
      Loaded="UiPage_Loaded">

    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="ProductCardTemplate">
            <ui:Card Padding="14">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Margin="0,10,0,0" FontSize="13" FontWeight="Medium" Text="{Binding StatusText, Mode=OneWay}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" FontFamily="Consolas" Text="{Binding InstallLocation, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Margin="0,6,0,0" FontSize="11" Text="{Binding ProgressText, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" Icon="ArrowDownload24"
                                   Content="{x:Static resources:Strings.Common_Navigation_Install}"
                                   IsEnabled="{Binding CanInstall, Mode=OneWay}"
                                   Command="{Binding InstallCommand}" />

                        <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Folder24"
                                   Content="{x:Static resources:Strings.Common_Open}"
                                   Command="{Binding OpenCommand}" />

                        <ui:Button Grid.Column="2" Margin="4,0,0,0" Icon="Delete24" Appearance="Secondary"
                                   Content="{x:Static resources:Strings.Common_Delete}"
                                   IsEnabled="{Binding CanDelete, Mode=OneWay}"
                                   Command="{Binding DeleteCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static resources:Strings.Installer_Manager_Title}" TextWrapping="Wrap" />
        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Installer_Manager_Text}" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Margin="0,0,4,0" Content="{Binding Player}" ContentTemplate="{StaticResource ProductCardTemplate}" />
            <ContentControl Grid.Column="1" Margin="4,0,0,0" Content="{Binding Studio}" ContentTemplate="{StaticResource ProductCardTemplate}" />
        </Grid>

        <TextBlock Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold" Text="{x:Static resources:Strings.Installer_Manager_Map_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Installer_Manager_Map_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ComboBox Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="160"
                  ItemsSource="{Binding AvailableDrives}"
                  SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                  IsEnabled="{Binding CanChangeMapLocation, Mode=OneWay}" />
    </StackPanel>
</ui:UiPage>
