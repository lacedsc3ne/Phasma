<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.CapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      mc:Ignorable="d"
      Title="CapturePage"
      Scrollable="False">
    <controls:SectionHost x:Name="Host" Margin="0,4,0,0">
        <controls:SectionItem Label="Screenshots" PageType="{x:Type pages:CaptureScreenshotsPage}" />
        <controls:SectionItem Label="Instant Replay" PageType="{x:Type pages:CaptureReplayPage}" />
        <controls:SectionItem Label="Storage" PageType="{x:Type pages:CaptureStoragePage}" />
    </controls:SectionHost>
</ui:UiPage>
