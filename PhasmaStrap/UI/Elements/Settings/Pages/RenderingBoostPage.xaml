<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RenderingBoostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="RenderingBoostPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_Rendering_BoostOptions}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Performance_SystemBoost_Description}" />
        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Rendering_GPUTimerPowerPlanTweaksApplied}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_ForceHighPerformanceGpu_Title}" Description="{x:Static resources:Strings.Menu_Performance_ForceHighPerformanceGpu_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ForceHighPerformanceGpu, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_DisableGameDVR_Title}" Description="{x:Static resources:Strings.Menu_Performance_DisableGameDVR_Description}">
            <ui:ToggleSwitch IsChecked="{Binding DisableGameDVR, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_BoostTimerResolution_Title}" Description="{x:Static resources:Strings.Menu_Performance_BoostTimerResolution_Description}">
            <ui:ToggleSwitch IsChecked="{Binding BoostTimerResolution, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_UseHighPerformancePowerPlan_Title}" Description="{x:Static resources:Strings.Menu_Performance_UseHighPerformancePowerPlan_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseHighPerformancePowerPlan, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_CleanRam_Title}" Description="{x:Static resources:Strings.Menu_Performance_CleanRam_Description}">
            <ui:Button Content="{x:Static resources:Strings.Menu_Performance_CleanRam_Button}" Icon="Broom28" Command="{Binding CleanRamCommand, Mode=OneTime}" />
        </controls:OptionControl>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding CleanRamStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_AutoCleanRam_Title}" Description="{x:Static resources:Strings.Menu_Performance_AutoCleanRam_Description}">
            <ui:ToggleSwitch IsChecked="{Binding AutoCleanRam, Mode=TwoWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
