<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.CaptureReplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:CaptureViewModel, IsDesignTimeCreatable=True}"
      Title="CaptureReplayPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <Style x:Key="HotkeyCaptureButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Click, then press the key or combination. Esc cancels and keeps the current hotkey." />
        </Style>

        <Style x:Key="HotkeyStatusText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Capture_InstantReplay}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Capture_ContinuouslyBuffersLastSeveralSecondsGameplay}" />

        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <ui:Button Content="{Binding AllClipsText}" Icon="VideoClip24" Appearance="Primary" ToolTip="{x:Static resources:Strings.Menu_Capture_EveryClipSearchFiltersRename}" Command="{Binding OpenClipLibraryCommand, Mode=OneTime}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Capture_OpenFolder}" Icon="Folder24" Appearance="Secondary" Command="{Binding OpenReplaysFolderCommand, Mode=OneTime}" />
        </StackPanel>

        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ReplayStatus, Mode=OneWay}" />

        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,16">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasReplays}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="VideoClip24" FontSize="40" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Capture_NoReplaysSavedYet}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" Opacity="0.5" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecentReplays, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,6" Padding="12,10" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <ui:Card.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{x:Static resources:Strings.Common_Copy}" Command="{Binding Tag.CopyReplayCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Menu_Capture_CopyFilePath}" Command="{Binding Tag.CopyReplayPathCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Link24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static resources:Strings.Common_Open}" Command="{Binding Tag.OpenReplayCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Common_Edit}" Command="{Binding Tag.EditReplayCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Common_Rename}" Command="{Binding Tag.RenameReplayCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Rename24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Menu_Capture_ShowFolder}" Command="{Binding Tag.RevealReplayCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static resources:Strings.Common_Delete}" Command="{Binding Tag.DeleteReplayCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Card.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Cursor="Hand">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="128" Height="72" Margin="0,0,12,0" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="3,1" CornerRadius="3" Background="#B0000000">
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="12" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TakenDisplay}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Margin="0,0,6,0" Padding="6,4" Appearance="Secondary" Icon="Copy16" Content="{x:Static resources:Strings.Common_Copy}" ToolTip="{x:Static resources:Strings.Menu_Capture_CopyClipClipboardReadyPasteInto}"
                                           Command="{Binding DataContext.CopyReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Padding="6,4" Appearance="Secondary" Icon="Cut24" Content="{x:Static resources:Strings.Common_Edit}" ToolTip="{x:Static resources:Strings.Menu_Capture_TrimCropSlowDownSpeedUp}" Visibility="{Binding EditVisibility}"
                                           Command="{Binding DataContext.EditReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Margin="6,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16" ToolTip="{x:Static resources:Strings.Menu_Capture_DeleteClip}"
                                           Command="{Binding DataContext.DeleteReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:OptionControl Margin="0,12,0,0" Header="Save Instant Replay hotkey" Description="Press this while a game is running to write the last few seconds to a clip.">
            <StackPanel Orientation="Horizontal">
                <ui:Button Uid="Capture" Content="{Binding ReplayHotkey.ButtonText}" Tag="{Binding ReplayHotkey}" Click="CaptureButton_Click">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource HotkeyCaptureButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReplayHotkey.IsListening}" Value="True">
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Margin="8,0,0,0" Focusable="False" Content="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}" Appearance="Secondary"
                           IsEnabled="{Binding ReplayHotkey.HasGesture}" Tag="{Binding ReplayHotkey}" Click="ClearButton_Click" />
            </StackPanel>
        </controls:OptionControl>

        <TextBlock Text="{Binding ReplayHotkey.StatusText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HotkeyStatusText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ReplayHotkey.HasStatus}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ReplayHotkey.StatusIsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_EnableInstantReplay}" x:Name="InstantReplayOption">
            <ui:ToggleSwitch IsChecked="{Binding InstantReplayEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_ClipLength}" Description="{x:Static resources:Strings.Menu_Capture_SecondsBufferedGameplayKeepSaveWhen}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="260" Minimum="5" Maximum="{Binding MaxClipSeconds, Mode=OneTime}" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding InstantReplayClipSeconds, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" FontFamily="Consolas" Text="{Binding ClipLengthText, Mode=OneWay}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="Quality preset" Description="Sets the frame rate, resolution, quality and encoder together. Pick Custom to set them yourself."
                                IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
            <ComboBox Width="160" ItemsSource="{Binding PresetOptions, Mode=OneTime}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_FrameRate}" Description="{x:Static resources:Strings.Menu_Capture_HowManyFramesPerSecondClip}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
            <Grid MinWidth="160">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding SelectedFps, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                <ComboBox Width="140" HorizontalAlignment="Right" ItemsSource="{Binding FpsOptions, Mode=OneTime}" SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                          Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
            </Grid>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_InGameResolutionMode_Title}" Description="{x:Static resources:Strings.Menu_Capture_NativeRecordsGameAtExactlySize}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
            <Grid MinWidth="160">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding SelectedResolution, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                <ComboBox Width="140" HorizontalAlignment="Right" ItemsSource="{Binding ResolutionOptions, Mode=OneTime}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                          Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
            </Grid>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_Quality}" Description="{x:Static resources:Strings.Menu_Capture_PictureQualitySavedClipHigherMeans}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
            <Grid MinWidth="160">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding SelectedQuality, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                <ComboBox Width="140" HorizontalAlignment="Right" ItemsSource="{Binding QualityOptions, Mode=OneTime}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                          Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
            </Grid>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_EncodeGraphicsCard}" Description="{x:Static resources:Strings.Menu_Capture_FramesStayGPUAreEncodedAs}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
            <Grid MinWidth="160">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding GpuEncodingText, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding GpuEncoding, Mode=TwoWay}" Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
            </Grid>
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_RecordGameSound}" Description="{x:Static resources:Strings.Menu_Capture_OnlyWhatRobloxItselfPlaysNot}" IsEnabled="{Binding SoundAvailable, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding RecordSound, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_RecordMyMicrophoneToo}" Description="{x:Static resources:Strings.Menu_Capture_MixesMicrophoneIntoClipExactlyAs}" IsEnabled="{Binding SoundAvailable, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding RecordMicrophone, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_Microphone}" Description="{x:Static resources:Strings.Menu_Capture_WhichMicrophoneRecordWindowsDefaultOne}" IsEnabled="{Binding MicrophonePickerEnabled, Mode=OneWay}">
            <ComboBox Width="260" Padding="10,5,10,5" ItemsSource="{Binding MicrophoneOptions, Mode=OneTime}" SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_CopyNewClipsClipboard}" Description="{x:Static resources:Strings.Menu_Capture_WhenReplayFinishesSavingClipCopied}">
            <ui:ToggleSwitch IsChecked="{Binding CopyReplayToClipboard, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ReplayEstimateText, Mode=OneWay}" />
    </StackPanel>
</ui:UiPage>
