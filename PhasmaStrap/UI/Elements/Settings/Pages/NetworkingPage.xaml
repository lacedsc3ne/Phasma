<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NetworkingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      Title="NetworkingPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Networking" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Local proxy, certificate trust, presence spoofing, and other network-level tweaks for the Roblox client." />

        <controls:OptionControl Margin="0,16,0,0" Header="Enable local proxy" Description="{Binding StatusText, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Certificate" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="The proxy needs a certificate trusted by your account to avoid TLS errors when it terminates Roblox's HTTPS connections. This installs only to your Windows user account's certificate store, not the whole machine, and only affects apps that use the Windows certificate store (Chrome/Edge do, Firefox doesn't)." />

        <controls:OptionControl Header="Local proxy certificate" Description="{Binding CertificateStatusText, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Install" Icon="ShieldCheckmark24" Margin="0,0,8,0" Command="{Binding InstallCertificateCommand, Mode=OneTime}" />
                <ui:Button Content="Remove" Icon="Delete24" Appearance="Secondary" Command="{Binding RemoveCertificateCommand, Mode=OneTime}" />
            </StackPanel>
        </controls:OptionControl>

        <TextBlock Text="Presence" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Changes what session type Roblox's own servers think you're connecting from." />
        <controls:OptionControl Header="Presence mode">
            <ComboBox Width="160" ItemsSource="{Binding PresenceSpoofModes, Mode=OneTime}" SelectedItem="{Binding SelectedPresenceSpoofMode, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Robux balance" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Shows a different balance on your own screen only - your real balance on Roblox's servers is never touched. Leave blank to disable." />
        <controls:OptionControl Header="Displayed balance">
            <ui:TextBox Width="160" PlaceholderText="Real balance" Text="{Binding RobuxSpoofAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:OptionControl>

        <TextBlock Text="Display name" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Overrides the name shown in-game for any profile PhasmaStrap looks up while this is set. Leave blank to disable." />
        <controls:OptionControl Header="Display name override">
            <ui:TextBox Width="200" PlaceholderText="Real name" Text="{Binding UsernameSpoofName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:OptionControl>

        <TextBlock Text="Telemetry" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Blackholes Roblox's own telemetry and crash-upload domains at the hosts-file level. Separate from the local proxy above." />
        <controls:OptionControl Header="Block Roblox telemetry" Description="{Binding TelemetryBlockerStatusText, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding BlockRobloxTelemetry, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="AssetWarp" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Blocks whole categories of asset from loading in-game, for a performance boost. Works by removing blocked asset types from the batch resolution request Roblox's client sends through the local proxy above, before it ever learns a CDN URL to fetch them from - it does not intercept or substitute the actual asset content servers. Requires the local proxy above to be enabled." />
        <controls:OptionControl Header="Enable AssetWarp" Description="{Binding AssetWarpStatusText, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding AssetWarpEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:CardExpander Margin="0,8,0,0">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Blocked asset types" />
                    <TextBlock FontSize="12" Text="Choose which asset categories AssetWarp removes from the batch resolution request." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <controls:OptionControl Header="Block textures">
                    <ui:ToggleSwitch IsChecked="{Binding AssetWarpDisableAllTextures, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Block decals">
                    <ui:ToggleSwitch IsChecked="{Binding AssetWarpDisableAllDecals, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Block images">
                    <ui:ToggleSwitch IsChecked="{Binding AssetWarpDisableAllImages, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Block animations">
                    <ui:ToggleSwitch IsChecked="{Binding AssetWarpDisableAllAnimations, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Block meshes">
                    <ui:ToggleSwitch IsChecked="{Binding AssetWarpDisableAllMeshes, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="Folder24">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="Preload cache" />
                        <TextBlock FontSize="12" Text="{Binding PreloadCacheSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Content="Refresh" Icon="ArrowClockwise24" Command="{Binding RefreshPreloadCacheCommand, Mode=OneTime}" />
                        <ui:Button Content="Clear all" Icon="Delete24" Appearance="Danger" Command="{Binding ClearPreloadCacheCommand, Mode=OneTime}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <TextBlock Text="Each entry is a cached asset-resolution response, keyed by a hash of the request - not an asset name, so there's nothing more specific to show per entry than size and when it was last used." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding PreloadCacheEntries, Mode=OneWay}" MaxHeight="240">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" FontFamily="Consolas" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0" VerticalAlignment="Center">
                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}" /><Run Text=" • " /><Run Text="{Binding LastAccessedDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <ui:Button Grid.Column="2" Padding="4" Appearance="Transparent" Icon="Delete16"
                                               Command="{Binding DataContext.DeletePreloadCacheEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock Text="Panic Wipe" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Immediately signs you out of Roblox and clears every cache/log directory and the AssetWarp preload cache in one action. Different from the Cleanup schedule on the Deployment page, which only runs after Roblox closes and only for whichever directories you've opted into - this runs right now, always covers everything, and always signs you out too." />

        <ui:Card Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="14" Text="Wipe everything now" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding WipeStatus, Mode=OneWay}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Wipe" Icon="Delete24" Appearance="Danger" Command="{Binding WipeAllCommand, Mode=OneTime}" />
            </Grid>
        </ui:Card>
    </StackPanel>
</ui:UiPage>
