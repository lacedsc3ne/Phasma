<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.OverlaysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="OverlaysPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Overlays_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Overlays_Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_Overlays_StatsHud_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_ShowFps_Title}" Description="{x:Static resources:Strings.Menu_Overlays_ShowFps_Description}">
            <ui:ToggleSwitch IsChecked="{Binding HudEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_Diagnostics_Title}" Description="{x:Static resources:Strings.Menu_Overlays_Diagnostics_Description}">
            <ui:ToggleSwitch IsChecked="{Binding DiagnosticsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:CardExpander Margin="0,8,0,0" Icon="DataBarVertical24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Extra HUD rows" />
                    <TextBlock FontSize="12" Text="Add more stat rows below FPS - each is shown as its own line on the same HUD panel." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <controls:OptionControl Header="Frame time" Description="Milliseconds per frame, alongside FPS.">
                    <ui:ToggleSwitch IsChecked="{Binding ShowFrameTime, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="CPU usage" Description="Total system CPU usage, all cores.">
                    <ui:ToggleSwitch IsChecked="{Binding ShowCpu, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="RAM usage" Description="Physical memory currently in use.">
                    <ui:ToggleSwitch IsChecked="{Binding ShowRam, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Server ping" Description="Round-trip time to the current game server. Shows -- if the server's address isn't known yet.">
                    <ui:ToggleSwitch IsChecked="{Binding ShowPing, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock Text="Focus mode" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Instantly hides the HUD and crosshair without turning them off - handy right before a screenshot or clip. Bind the Toggle Overlay Focus Mode hotkey on the Hotkeys page to flip this during a game session." />

        <controls:OptionControl Header="Overlay Focus Mode" Description="While on, the HUD and crosshair are hidden regardless of their own toggles above.">
            <ui:ToggleSwitch IsChecked="{Binding FocusModeEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Per-game overlay profiles" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Override whether the HUD and crosshair show up in specific games, regardless of the global toggles above." />

        <ui:CardExpander Margin="0,8,0,0" Icon="Games24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Game overrides" />
                    <TextBlock FontSize="12" Text="Add a place ID with its own HUD/crosshair state." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:TextBox Width="140" PlaceholderText="Place ID" Text="{Binding AssignPlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="12,0,0,0" Content="HUD" VerticalAlignment="Center" IsChecked="{Binding AssignHudEnabled, Mode=TwoWay}" />
                    <CheckBox Margin="12,0,0,0" Content="Crosshair" VerticalAlignment="Center" IsChecked="{Binding AssignCrosshairEnabled, Mode=TwoWay}" />
                    <ui:Button Margin="12,0,0,0" Content="{x:Static resources:Strings.Common_AddSingle}" Command="{Binding AddPlaceProfileCommand, Mode=OneTime}" />
                </StackPanel>
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PlaceProfiles, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,6" Padding="8,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Display}" FontFamily="Consolas" FontSize="12" />
                                    <ui:Button Margin="8,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16" Command="{Binding DataContext.RemovePlaceProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock Text="{x:Static resources:Strings.Menu_Overlays_Crosshair_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairEnabled_Title}" Description="{x:Static resources:Strings.Menu_Overlays_CrosshairEnabled_Description}">
            <ui:ToggleSwitch IsChecked="{Binding CrosshairEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairShape_Title}" Description="{x:Static resources:Strings.Menu_Overlays_CrosshairShape_Description}">
            <ComboBox Width="140" SelectedIndex="{Binding CrosshairShapeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Static resources:Strings.Menu_Overlays_CrosshairShape_Cross}" />
                <ComboBoxItem Content="{x:Static resources:Strings.Menu_Overlays_CrosshairShape_Dot}" />
                <ComboBoxItem Content="{x:Static resources:Strings.Menu_Overlays_CrosshairShape_Ring}" />
            </ComboBox>
        </controls:OptionControl>

        <ui:CardExpander Margin="0,8,0,0" Icon="Target24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Overlays_CrosshairAppearance_Title}" />
                    <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Overlays_CrosshairAppearance_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairSize_Title}">
                    <ui:NumberBox Width="140" Min="2" Max="60" Value="{Binding CrosshairSize, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairLineThickness_Title}">
                    <ui:NumberBox Width="140" Min="1" Max="16" Value="{Binding CrosshairLineThickness, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairGap_Title}">
                    <ui:NumberBox Width="140" Min="0" Max="40" Value="{Binding CrosshairGap, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairOpacity_Title}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="200" Minimum="0.05" Maximum="1" TickFrequency="0.05" Value="{Binding CrosshairOpacity, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding CrosshairOpacity, Mode=OneWay, StringFormat={}{0:0.00}}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairColor_Title}" Description="{x:Static resources:Strings.Menu_Overlays_CrosshairColor_Description}">
                    <TextBox Width="140" Text="{Binding CrosshairColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairOutlineColor_Title}" Description="{x:Static resources:Strings.Menu_Overlays_CrosshairOutlineColor_Description}">
                    <TextBox Width="140" Text="{Binding CrosshairOutlineColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</ui:UiPage>
