<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels.ContextMenu"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance models:AccountSwitcherViewModel, IsDesignTimeCreatable=False}"
      Title="AccountsPage"
      Scrollable="True"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Roblox accounts" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Accounts_SaveMultipleRobloxLoginsSwitchBetween}" />

        <Border Margin="0,12,0,0" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Image Source="{Binding CurrentAvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                        </Image.Clip>
                    </Image>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Opacity="0.65" Text="{x:Static resources:Strings.Menu_Accounts_SignedAs}" />
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding CurrentTitle}" />
                    <TextBlock FontSize="12" Opacity="0.75" Text="{Binding CurrentSubtitle}" />
                    <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,0" Text="{Binding Status}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{x:Static resources:Strings.Menu_Accounts_AddAccount}" Icon="PersonAdd24" Appearance="Primary" IsEnabled="{Binding AddCurrentEnabled}" Command="{Binding AddCurrentCommand}" />
                    <ui:Button Content="{x:Static resources:Strings.Menu_Accounts_SignOut}" Icon="SignOut24" Appearance="Danger" Margin="8,0,0,0" Visibility="{Binding LoggedInVisibility}" Command="{Binding LogoutCommand}" />
                    <ui:Button Icon="ArrowClockwise24" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static resources:Strings.Menu_Accounts_SearchSavedAccountsByNameNote}" Icon="Search24" ClearButtonEnabled="True" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Content="{x:Static resources:Strings.Menu_Accounts_LogBrowser}" Icon="Globe24" Appearance="Primary" Margin="8,0,0,0" Command="{Binding LoginWithBrowserCommand, Mode=OneTime}" />
            <ui:Button Grid.Column="2" Content="{x:Static resources:Strings.Menu_Accounts_ImportByCookie}" Icon="Key24" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding ToggleImportCommand}" />
            <ui:Button Grid.Column="3" Content="{x:Static resources:Strings.Menu_Accounts_Folder}" Icon="Folder24" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
        </Grid>

        <ui:CardExpander Margin="0,10,0,0" Icon="PersonAdd24" IsExpanded="{Binding ImportVisible, Mode=TwoWay}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Add an account" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Accounts_ImportAccountFromItsROBLOSECURITYCookie}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <TextBlock Margin="0,0,0,8" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{x:Static resources:Strings.Menu_Accounts_PasteFullROBLOSECURITYValueOnlyPaste}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static resources:Strings.Menu_Accounts_WARNINGDONOTSHARE}" Text="{Binding NewCookieText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Content="{x:Static resources:Strings.Common_Import}" Icon="ArrowImport24" Appearance="Primary" Margin="8,0,0,0" Command="{Binding ImportCookieCommand}" />
                </Grid>
                <ui:Button Margin="0,8,0,0" Content="{x:Static resources:Strings.Menu_Accounts_ImportSeveralAtOnceInstead}" Appearance="Transparent" HorizontalAlignment="Left" Padding="0" Command="{Binding ToggleBulkImportCommand}" />

                <Border Margin="0,10,0,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding BulkImportVisibility}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Accounts_BulkImportFromCookies}" />
                        <TextBlock Margin="0,2,0,8" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{x:Static resources:Strings.Menu_Accounts_PasteOneROBLOSECURITYValuePerLine}" />
                        <ui:TextBox Text="{Binding BulkCookieText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="10" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                        <ui:Button Margin="0,8,0,0" Content="{x:Static resources:Strings.Menu_Accounts_ImportAll}" Icon="ArrowImport24" Appearance="Primary" HorizontalAlignment="Left" Command="{Binding BulkImportCookiesCommand, Mode=OneTime}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding FilteredAccounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SwitcherAccount}">
                    <Border CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21" />
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding CurrentBadgeVisibility}">
                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{x:Static resources:Strings.Menu_Accounts_CURRENT}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Subtitle}" />
                                <TextBlock FontSize="11" Opacity="0.55" Margin="0,1,0,0" Text="{Binding LastUsedDisplay}" />
                            </StackPanel>

                            <ui:TextBox Grid.Column="2" VerticalAlignment="Center" Margin="10,0" MinWidth="120" MaxWidth="200" PlaceholderText="{x:Static resources:Strings.Menu_Accounts_AddNote}" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="{x:Static resources:Strings.Menu_Accounts_Switch}" Icon="ArrowSwap24" Appearance="Primary" Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Icon="Copy24" ToolTip="{x:Static resources:Strings.Menu_Accounts_CopyUserID}" Appearance="Secondary" Margin="6,0,0,0" Command="{Binding DataContext.CopyUserIdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Icon="Delete24" ToolTip="{x:Static resources:Strings.Menu_Accounts_RemoveSavedAccount}" Appearance="Danger" Margin="6,0,0,0" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Visibility="{Binding EmptyStateVisibility}" Padding="30" CornerRadius="8" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding EmptyStateTitle}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Text="{Binding EmptyStateSubtitle}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,10,0,0" FontSize="12" Opacity="0.7" Text="{Binding Accounts.Count, StringFormat=Saved accounts: {0}}" />

        <StackPanel x:Name="GuardRoot" Margin="0,26,0,0">
            <TextBlock Text="{x:Static resources:Strings.Menu_Accounts_AccountGuard}" FontSize="20" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static resources:Strings.Menu_Accounts_WarnsYouAboutWhatLoginStealers}" />

            <controls:OptionControl Margin="0,12,0,0" Header="{x:Static resources:Strings.Menu_Accounts_TurnAccountGuard}"
                                    Description="{x:Static resources:Strings.Menu_Accounts_ChecksHostsFileTrustedCertificatesRoblox}">
                <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Accounts_WatchSignFileBackground}"
                                    Description="{x:Static resources:Strings.Menu_Accounts_RunsSmallPhasmaStrapProcessFromWhen}"
                                    IsEnabled="{Binding Enabled}">
                <ui:ToggleSwitch IsChecked="{Binding Background, Mode=TwoWay}" />
            </controls:OptionControl>

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:Button Icon="ShieldCheckmark24" Content="{x:Static resources:Strings.Menu_Accounts_CheckNow}" Command="{Binding CheckNowCommand, Mode=OneTime}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}" />
            </StackPanel>

            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Content="{x:Static resources:Strings.Menu_Accounts_Fine}" ToolTip="{x:Static resources:Strings.Menu_Accounts_YouKnowAboutDonTMention}"
                                           Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding HistoryVisibility}">
                <TextBlock Margin="0,12,0,4" FontSize="14" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Accounts_RecentWarnings}" />
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="{Binding Utc, StringFormat={}{0:g} UTC, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
