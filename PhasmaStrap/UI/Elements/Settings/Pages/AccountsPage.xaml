<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels.ContextMenu"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance models:AccountSwitcherViewModel, IsDesignTimeCreatable=False}"
      Title="AccountsPage"
      Scrollable="True"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Accounts" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Save multiple Roblox logins, switch between them, and run several at once. Switch swaps Roblox's own login file and needs every window closed first - the next Play signs in as that account. Launch New Instance is different: it frees Roblox's own single-instance lock and opens another window alongside whatever's already running, optionally signed into a specific saved account. See Integrations for the popup version of the account list." />

        <Border Margin="0,12,0,0" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Image Source="{Binding CurrentAvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                        </Image.Clip>
                    </Image>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Opacity="0.65" Text="Signed in as" />
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding CurrentTitle}" />
                    <TextBlock FontSize="12" Opacity="0.75" Text="{Binding CurrentSubtitle}" />
                    <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,0" Text="{Binding Status}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Add this account" Icon="PersonAdd24" Appearance="Primary" IsEnabled="{Binding AddCurrentEnabled}" Command="{Binding AddCurrentCommand}" />
                    <ui:Button Content="Launch new instance" Icon="WindowNew24" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding LaunchNewInstanceCommand, Mode=OneTime}" />
                    <ui:Button Content="Sign out" Icon="SignOut24" Appearance="Danger" Margin="8,0,0,0" Visibility="{Binding LoggedInVisibility}" Command="{Binding LogoutCommand}" />
                    <ui:Button Icon="ArrowClockwise24" ToolTip="Refresh" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Search saved accounts by name, note, or user ID" Icon="Search24" ClearButtonEnabled="True" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Content="Import by cookie" Icon="Key24" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding ToggleImportCommand}" />
            <ui:Button Grid.Column="2" Content="Folder" Icon="Folder24" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
        </Grid>

        <Border Margin="0,10,0,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding ImportVisibility}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Import an account from its .ROBLOSECURITY cookie" />
                <TextBlock Margin="0,2,0,8" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="Paste a full .ROBLOSECURITY value. Only paste cookies you own." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" PlaceholderText="_|WARNING:-DO-NOT-SHARE-THIS..." Text="{Binding NewCookieText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Content="Import" Icon="ArrowImport24" Appearance="Primary" Margin="8,0,0,0" Command="{Binding ImportCookieCommand}" />
                </Grid>
                <ui:Button Margin="0,8,0,0" Content="Import several at once instead" Appearance="Transparent" HorizontalAlignment="Left" Padding="0" Command="{Binding ToggleBulkImportCommand}" />
            </StackPanel>
        </Border>

        <Border Margin="0,10,0,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding BulkImportVisibility}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Bulk import from cookies" />
                <TextBlock Margin="0,2,0,8" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="Paste one .ROBLOSECURITY value per line. Each is verified and saved the same way as a single import - only paste cookies you own." />
                <ui:TextBox Text="{Binding BulkCookieText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="10" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                <ui:Button Margin="0,8,0,0" Content="Import all" Icon="ArrowImport24" Appearance="Primary" HorizontalAlignment="Left" Command="{Binding BulkImportCookiesCommand, Mode=OneTime}" />
            </StackPanel>
        </Border>

        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding FilteredAccounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SwitcherAccount}">
                    <Border CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21" />
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding CurrentBadgeVisibility}">
                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="CURRENT" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Subtitle}" />
                                <TextBlock FontSize="11" Opacity="0.55" Margin="0,1,0,0" Text="{Binding LastUsedDisplay}" />
                            </StackPanel>

                            <ui:TextBox Grid.Column="2" VerticalAlignment="Center" Margin="10,0" PlaceholderText="Add a note" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Switch" Icon="ArrowSwap24" Appearance="Primary" ToolTip="Sign in as this account for the next Play - needs Roblox fully closed" Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Icon="WindowNew24" ToolTip="Launch a new instance signed in as this account" Appearance="Secondary" Margin="6,0,0,0" Command="{Binding DataContext.LaunchInstanceForAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Icon="Copy24" ToolTip="Copy user ID" Appearance="Secondary" Margin="6,0,0,0" Command="{Binding DataContext.CopyUserIdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Icon="Delete24" ToolTip="Remove saved account" Appearance="Danger" Margin="6,0,0,0" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Visibility="{Binding EmptyStateVisibility}" Padding="30" CornerRadius="8" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding EmptyStateTitle}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Text="{Binding EmptyStateSubtitle}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,10,0,0" FontSize="12" Opacity="0.7" Text="{Binding Accounts.Count, StringFormat=Saved accounts: {0}}" />

        <TextBlock Text="Running instances" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Every Roblox window currently open. Only the first one in a session gets Discord Rich Presence/hotkeys/overlays/auto-rejoin - PhasmaStrap's own single-Watcher limit, not a Roblox one." />

        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Instances, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="12" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <Run Text="PID " /><Run Text="{Binding ProcessId, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Opacity="0.7">
                                    <Run Text="{Binding UptimeDisplay, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding MemoryDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Focus" Icon="WindowArrowUp24" Appearance="Secondary" Command="{Binding DataContext.FocusInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Content="Close" Icon="Dismiss24" Appearance="Danger" Margin="8,0,0,0" Command="{Binding DataContext.CloseInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,16,16,16">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasInstances}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="WindowMultiple20" FontSize="36" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="No Roblox windows are running" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Opacity="0.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>
