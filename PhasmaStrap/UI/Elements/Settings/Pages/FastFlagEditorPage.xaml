<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.FastFlagEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FastFlagEditorPage"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <!-- The whole editor scrolls; the flag list keeps a usable minimum height and scrolls on its
         own. The layout height is worked out in code-behind (UpdateLayoutHeight) because a
         star-sized row inside a ScrollViewer would otherwise grow to fit every flag and switch
         virtualization off.

         One list, two kinds of thing to edit: "your flags" (every game) or one profile (only the
         games it is given to, on the Per-game flags tab). The Editing box at the top switches. -->
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="PageScroller_SizeChanged">
    <Grid x:Name="RootLayout" Margin="0,0,14,14" VerticalAlignment="Top" Height="700" LayoutUpdated="RootLayout_LayoutUpdated">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" FontSize="20" FontWeight="Medium" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Margin="0,4,0,0" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <controls:MarkdownTextBlock TextWrapping="Wrap" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlagEditor_AllowlistInformation}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://devforum.roblox.com/t/allowlist-for-local-client-configuration-via-fast-flags/3966569'}"  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <ui:InfoBar Margin="0,0,0,16" Padding="8" Title="{x:Static resources:Strings.Menu_FastFlagEditor_BannerTitle}" IsOpen="True" Message="{x:Static resources:Strings.Menu_FastFlagEditor_BannerText}" Severity="Warning" IsClosable="False" />

            <ui:InfoBar x:Name="ManagerDisabledBar" Margin="0,0,0,16" Padding="8" Title="{x:Static resources:Strings.Menu_FastFlagEditor_PhasmaStrapIsnTManagingFastFlagsRight}"
                        Message="{x:Static resources:Strings.Menu_FastFlagEditor_AllowPhasmaStrapManageFFlagsOffEngine}"
                        Severity="Warning" IsOpen="True" IsClosable="False" Visibility="Collapsed" />
        </StackPanel>

        <!-- what is being edited -->
        <Border Grid.Row="3" Margin="0,0,0,16" Padding="14,12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Margin="0,0,10,6" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Editing}" />
                    <ComboBox x:Name="ScopeBox" Width="300" Margin="0,0,8,6" DisplayMemberPath="Display" SelectionChanged="ScopeBox_SelectionChanged" />
                    <ui:Button Margin="0,0,8,6" Icon="Add24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_NewProfile}" Click="NewProfile_Click"
                               ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_ProfileHoldsFlagChangesChosenGames}" />
                    <ui:Button x:Name="ProfileMenuButton" Margin="0,0,8,6" Icon="MoreHorizontal24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ProfileOptions}" Click="ProfileMenu_Click" />
                </WrapPanel>

                <TextBlock x:Name="ScopeText" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <WrapPanel x:Name="UsedByPanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="UsedByText" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                    <ui:Button Padding="10,4" Icon="Games24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ChooseGames}" Click="GoToGames_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="4" Orientation="Horizontal">
            <ui:Button x:Name="AddButton" Icon="Add28" Content="{x:Static resources:Strings.Menu_FastFlagEditor_AddNew}" Click="AddButton_Click" Margin="0,0,12,16" />
            <ui:Button x:Name="TurnOffButton" Icon="SubtractCircle24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_TurnOffOneFlags}" Click="TurnOffButton_Click" Margin="0,0,12,16" Visibility="Collapsed"
                       ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_PickFlagsFromOwnListProfile}" />
            <ui:Button Icon="Delete48" Content="{x:Static resources:Strings.Menu_FastFlagEditor_DeleteSelected}" Click="DeleteButton_Click" Appearance="Danger"  Margin="0,0,12,16">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=DataGrid, Path=SelectedItems.Count}" Value="0">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
            <ui:Button Icon="Search24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_SearchDatabase}" Click="SearchDatabaseButton_Click" Margin="0,0,12,16" />
            <ui:Button Icon="ArrowExportRtl24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ExportJson}" Click="ExportJSONButton_Click" Margin="0,0,12,16" />
            <ToggleButton x:Name="TogglePresetsButton" Content="{x:Static resources:Strings.Menu_FastFlagEditor_HideToggleFlags}" Click="ToggleButton_Click" Margin="0,0,12,16"
                          ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_LeaveOutFlagsSetByToggles}" />
            <ToggleButton x:Name="ShowYoursButton" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ShowFlagsToo}" IsChecked="True" Click="ShowYoursButton_Click" Margin="0,0,12,16" Visibility="Collapsed"
                          ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_ListOwnFlagsAsWellSo}" />
        </WrapPanel>

        <ui:TextBox x:Name="SearchTextBox" Grid.Row="5" Margin="0,0,0,12" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_Search}" TextChanged="SearchTextBox_TextChanged" />

        <DataGrid Name="DataGrid" Grid.Row="6" MinHeight="320" controls:ScrollBubbling.Enabled="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CellEditEnding="DataGrid_CellEditEnding" BeginningEdit="DataGrid_BeginningEdit" CanUserReorderColumns="False" ContextMenuOpening="DataGrid_ContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu />
            </DataGrid.ContextMenu>

            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </DataGrid.Style>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="8,0,8,0" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource TextOnAccentFillColorPrimary}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*" />
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Note}" Width="1.5*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Note}" ToolTip="{Binding Note}" FontSize="12" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="Problem">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Added">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Changed">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Off">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyText" Grid.Row="6" Margin="10,48,10,0" VerticalAlignment="Top" IsHitTestVisible="False" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
    </Grid>
    </ScrollViewer>
</ui:UiPage>
