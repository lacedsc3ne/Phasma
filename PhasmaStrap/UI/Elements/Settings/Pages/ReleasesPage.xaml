<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ReleasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ReleasesViewModel, IsDesignTimeCreatable=True}"
      Title="ReleasesPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Releases_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Releases_Description}" />

        <Border Margin="0,12,0,0" Padding="18,16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding UpdateHeadline, Mode=OneWay}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UpdateDetail, Mode=OneWay}" />
                </StackPanel>

                <ui:Button Grid.Column="2" VerticalAlignment="Center" MinWidth="110" Icon="ArrowDownload24" Appearance="Primary"
                           Content="Update" Visibility="{Binding UpdateActionVisibility, Mode=OneWay}" Command="{Binding UpdateCommand, Mode=OneTime}" />
            </Grid>
        </Border>

        <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="8" BorderThickness="1" Visibility="{Binding WhatsNewVisibility}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding WhatsNewTitle, Mode=OneTime}" />
                </StackPanel>
                <controls:MarkdownTextBlock Margin="0,10,0,0" TextWrapping="Wrap" MarkdownText="{Binding WhatsNew}" />
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_Releases_SearchPlaceholder}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ui:Button Grid.Column="1" Margin="12,0,0,0" Content="{x:Static resources:Strings.Menu_Releases_Refresh}" Icon="ArrowClockwise24"
                       Command="{Binding RefreshCommand, Mode=OneTime}" />
        </Grid>

        <TextBlock Margin="0,10,0,0" Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" VerticalAlignment="Top" MaxHeight="620" HorizontalContentAlignment="Stretch"
                     controls:ScrollBubbling.Enabled="True"
                     ItemsSource="{Binding Releases, Mode=OneWay}"
                     SelectedItem="{Binding SelectedRelease, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Releases_Installed}" FontSize="10" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0" FontSize="11" Text="{Binding PublishedText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <ui:Card VerticalAlignment="Top" Visibility="{Binding DetailVisibility, Mode=OneWay}">
                    <StackPanel DataContext="{Binding SelectedRelease, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Releases_Installed}" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding PublishedText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <controls:MarkdownTextBlock Margin="0,10,0,0" TextWrapping="Wrap" MarkdownText="{Binding Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding AssetsVisibility, Mode=OneWay}">
                            <TextBlock FontSize="14" FontWeight="Medium">
                                <Run Text="{Binding AssetCount, Mode=OneWay}" />
                                <Run Text="{x:Static resources:Strings.Menu_Releases_Assets}" />
                            </TextBlock>

                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Assets, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SizeText}" />
                                                <ui:Button Grid.Column="2" Padding="8,4" Appearance="Secondary" Icon="ArrowDownload24" Content="Download"
                                                           Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding DownloadUrl}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ui:Hyperlink Margin="0,8,0,0" HorizontalAlignment="Left" Content="{x:Static resources:Strings.Menu_Releases_ViewOnGitHub}"
                                      Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding HtmlUrl}" />
                    </StackPanel>
                </ui:Card>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoSelectionVisibility, Mode=OneWay}"
                           Text="Pick a release on the left to read its notes and downloads." />
            </Grid>
        </Grid>
    </StackPanel>
</ui:UiPage>
