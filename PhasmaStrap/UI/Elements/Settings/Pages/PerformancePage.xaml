<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      Title="PerformancePage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="System-level tweaks and direct Roblox game settings." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="System" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl Header="CPU core limit" Description="Restricts how many logical processors PhasmaStrap itself can use. This affects the bootstrapper process only, not the Roblox game process.">
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Minimum="0" Maximum="{Binding MaxCpuCores, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CpuCoreLimit, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding CpuCoreLimitDisplay, Mode=OneWay}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="Fake exclusive fullscreen" Description="Strips the Roblox window's border and resizes it to exactly cover its monitor for lower input latency than Roblox's own windowed fullscreen.">
            <ui:ToggleSwitch IsChecked="{Binding FakeExclusiveFullscreen, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Duck Roblox audio when unfocused" Description="Automatically lowers Roblox's volume while you're tabbed away from it during a game session, and restores it when you switch back.">
            <ui:ToggleSwitch IsChecked="{Binding DuckRobloxAudioOnUnfocus, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Headset loudness" Description="Boosts quiet sounds (footsteps, distant cues) without letting loud moments blow out your ears.">
            <ui:ToggleSwitch IsChecked="{Binding HeadsetAudioEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Roblox game settings" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Text="These edit Roblox's own GlobalBasicSettings file directly, rather than going through FastFlags." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl Header="Lock settings file" Description="Marks the file read-only so Roblox can't silently overwrite these changes on its own.">
            <ui:ToggleSwitch IsChecked="{Binding SettingsFileReadOnly, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Framerate cap" Description="0 leaves it uncapped.">
            <ui:NumberBox Width="140" Min="0" Max="10000" Value="{Binding FramerateCap, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Graphics quality level" Description="0 to 10, where 10 is Roblox's highest preset. Only takes effect when graphics mode isn't set to Automatic in-game.">
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SavedQualityLevel, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding SavedQualityLevel, Mode=OneWay}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="Mouse sensitivity">
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Minimum="0.01" Maximum="10" TickFrequency="0.01" Value="{Binding MouseSensitivity, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding MouseSensitivity, Mode=OneWay, StringFormat={}{0:0.00}}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="Reduced motion" Description="Cuts down on in-game UI animation.">
            <ui:ToggleSwitch IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="VR enabled">
            <ui:ToggleSwitch IsChecked="{Binding VREnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Show performance stats" Description="Roblox's built-in FPS/ping/memory overlay.">
            <ui:ToggleSwitch IsChecked="{Binding PerformanceStatsVisible, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Anti-Aliasing" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Text="Applies a GPU shader over the Roblox window to smooth jagged edges. Runs as its own overlay window, so it costs extra GPU time on top of Roblox's own rendering." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl Header="Enable Anti-Aliasing overlay" Description="Off by default, since this is an extra rendering pass on top of Roblox.">
            <ui:ToggleSwitch IsChecked="{Binding AntiAliasingEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Anti-Aliasing method" Description="Which shader technique to apply once the overlay is enabled.">
            <ComboBox Padding="10,5,10,5" MinWidth="160" IsEnabled="{Binding AntiAliasingEnabled}" ItemsSource="{Binding AntiAliasingMethodNames, Mode=OneTime}" SelectedIndex="{Binding AntiAliasingMethodIndex, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Cleanup" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Text="Automatically deletes old files after Roblox closes." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl Header="Schedule">
            <ComboBox Width="160" ItemsSource="{Binding CleanerScheduleOptions, Mode=OneTime}" SelectedItem="{Binding CleanerSchedule, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="PhasmaStrap logs">
            <ui:ToggleSwitch IsChecked="{Binding CleanerLogsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="PhasmaStrap download cache">
            <ui:ToggleSwitch IsChecked="{Binding CleanerCacheEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Roblox logs">
            <ui:ToggleSwitch IsChecked="{Binding CleanerRobloxLogsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Roblox cache">
            <ui:ToggleSwitch IsChecked="{Binding CleanerRobloxCacheEnabled, Mode=TwoWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
