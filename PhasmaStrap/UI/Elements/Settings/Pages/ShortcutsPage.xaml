<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ShortcutsViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ShortcutsPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Common_Shortcuts}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,2,0,0" Text="{x:Static resources:Strings.Menu_Shortcuts_Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:Card Margin="0,14,0,0">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Medium" Text="Create a shortcut" />
                <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Pick what it should launch and where the file goes. A game shortcut uses that game's own icon." />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="What it launches" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox Grid.Column="1" Padding="10,5,10,5" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ShortcutTargets, Mode=OneTime}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedShortcutTarget, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,10,0,0" Visibility="{Binding IsGameTargetSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Place ID or game link" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" PlaceholderText="{x:Static resources:Strings.Menu_Shortcuts_PlaceIDGameLink}" Text="{Binding GameShortcutInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{x:Static resources:Strings.Menu_Shortcuts_GameShortcuts_Description}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Where to put it" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox Grid.Column="1" Padding="10,5,10,5" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ShortcutLocations, Mode=OneTime}"
                              SelectedItem="{Binding SelectedShortcutLocation, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GameShortcutStatus, Mode=OneWay}" />
                    <ui:Button Grid.Column="1" Margin="12,0,0,0" Icon="Add28" Appearance="Primary" Content="{x:Static resources:Strings.Menu_Shortcuts_CreateShortcut}"
                               IsEnabled="{Binding NotBusy, Mode=OneWay}" Command="{Binding CreateShortcutCommand, Mode=OneTime}" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Your shortcuts" FontSize="20" FontWeight="Medium" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Every shortcut on your desktop or start menu that opens PhasmaStrap." />
            </StackPanel>
            <ui:Button Grid.Column="1" Margin="12,0,0,0" Icon="ArrowClockwise24" Appearance="Secondary" Content="Refresh" Command="{Binding RefreshShortcutsCommand, Mode=OneTime}" />
        </Grid>

        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="No shortcuts yet. Create one above, or turn on a quick shortcut below.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasExistingShortcuts}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ExistingShortcuts, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Link24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon, Mode=OneTime}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneTime}" ToolTip="{Binding Path, Mode=OneTime}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Launches, Mode=OneTime}" />
                                    <TextBlock FontSize="12" Margin="6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="&#183;" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Location, Mode=OneTime}" />
                                </StackPanel>
                            </StackPanel>

                            <ui:Button Grid.Column="2" Margin="12,0,0,0" Icon="Delete24" Appearance="Secondary" Content="Remove"
                                       Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:CardExpander Margin="0,14,0,0">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Shortcuts_General_Title}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Shortcuts_General_Description}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:OptionControl Grid.Column="0" Margin="0,0,4,0" Header="{x:Static resources:Strings.Common_Shortcuts_Desktop}">
                        <ui:ToggleSwitch IsChecked="{Binding DesktopIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Grid.Column="1" Margin="4,0,0,0" Header="{x:Static resources:Strings.Common_Shortcuts_StartMenu}">
                        <ui:ToggleSwitch IsChecked="{Binding StartMenuIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>
                </Grid>

                <TextBlock Margin="0,12,0,0" Text="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />

                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStudioOptionVisible}" Value="False">
                                            <Setter Property="Width" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:OptionControl Grid.Column="0" Margin="0,0,2,0" Header="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}">
                        <ui:ToggleSwitch IsChecked="{Binding PlayerIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Grid.Column="1" Margin="2,0,2,0" Header="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}">
                        <ui:ToggleSwitch IsChecked="{Binding StudioIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Grid.Column="2" Margin="2,0,0,0" Header="{x:Static resources:Strings.Menu_Title}">
                        <ui:ToggleSwitch IsChecked="{Binding SettingsIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>
                </Grid>

                <controls:OptionControl
                    Margin="0,12,0,0"
                    Header="{x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Title}"
                    Description="{Binding Source={x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Description}, Converter={StaticResource StringFormatConverter},ConverterParameter='https://bloxstraplabs.com/wiki/info/using-roblox-icons-for-shortcuts/'}">
                    <ui:ToggleSwitch IsChecked="{Binding ExtractIconsTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock Text="{x:Static resources:Strings.Menu_Shortcuts_StudioCompanion_Title}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Shortcuts_StudioCompanion_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Shortcuts_EnableStudioCompanion}" Description="{Binding StudioPluginStatus, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{x:Static resources:Strings.Menu_Shortcuts_Reinstall}" Icon="ArrowClockwise24" Margin="0,0,8,0" IsEnabled="{Binding StudioPluginEnabled}" Command="{Binding ReinstallStudioPluginCommand, Mode=OneTime}" />
                <ui:ToggleSwitch IsChecked="{Binding StudioPluginEnabled, Mode=TwoWay}" />
            </StackPanel>
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
