<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:DiagnosticsViewModel, IsDesignTimeCreatable=False}"
      Title="DiagnosticsPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_PhasmaStrap_Section_Diagnostics_Header}" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_ToolsFindOutWhatWrongSay}" />

        <TabControl Margin="0,12,0,0" x:Name="Tabs">
            <!-- ============================================================ health check -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="HeartPulse24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_HealthCheck}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" Text="{Binding HealthSummary, Mode=OneWay}" />
                        <ui:Button Grid.Column="1" Margin="12,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_RunCheck}" Icon="Play24" Appearance="Primary" AutomationProperties.Name="Run the check"
                                   Command="{Binding RunHealthCommand, Mode=OneTime}" IsEnabled="{Binding HealthIdle, Mode=OneWay}" />
                    </Grid>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Health, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" Foreground="{Binding Color}" FontSize="20" Margin="0,1,12,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="{Binding FixLabel}" Icon="Wrench24" Visibility="{Binding FixVisibility}" Command="{Binding FixCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- ============================================================ connection -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Router24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_Connection}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ServerText, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="150" ItemsSource="{Binding DurationOptions, Mode=OneTime}" SelectedItem="{Binding SelectedDuration, Mode=TwoWay}" IsEnabled="{Binding ConnectionIdle, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_TestConnection}" Icon="Play24" Appearance="Primary" AutomationProperties.Name="Test the connection"
                                   Command="{Binding RunConnectionCommand, Mode=OneTime}" IsEnabled="{Binding ConnectionIdle, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_Stop}" Icon="Stop24" Appearance="Secondary" Command="{Binding CancelConnectionCommand, Mode=OneTime}" Visibility="{Binding ConnectionBusyVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding ConnectionProgress, Mode=OneWay}" Visibility="{Binding ConnectionBusyVisibility, Mode=OneWay}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ConnectionStatus, Mode=OneWay}" />

                    <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1" Visibility="{Binding ConnectionVerdictVisibility, Mode=OneWay}"
                            BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ConnectionVerdict, Mode=OneWay}" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ConnectionFindings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PingRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Address, Mode=OneWay}" /></TextBlock>
                                            <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Numbers}" />
                                        </StackPanel>
                                        <Canvas Grid.Column="1" Width="300" Height="40" ClipToBounds="True" VerticalAlignment="Center">
                                            <Polyline Points="{Binding Spark}" Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:CardExpander Margin="0,4,0,0" Header="{x:Static resources:Strings.Menu_Diagnostics_RouteStationByStation}">
                        <ItemsControl ItemsSource="{Binding RouteRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,1" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>

                    <TextBlock Margin="2,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_RobloxGameServersIgnorePingsSo}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</ui:UiPage>
