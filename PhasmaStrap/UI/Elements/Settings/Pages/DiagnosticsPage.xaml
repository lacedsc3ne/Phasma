<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:DiagnosticsViewModel, IsDesignTimeCreatable=False}"
      Title="DiagnosticsPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_PhasmaStrap_Section_Diagnostics_Header}" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_ToolsFindOutWhatWrongSay}" />

        <TabControl Margin="0,12,0,0" x:Name="Tabs">
            <!-- ============================================================ health check -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="HeartPulse24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_HealthCheck}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" Text="{Binding HealthSummary, Mode=OneWay}" />
                        <ui:Button Grid.Column="1" Margin="12,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_RunCheck}" Icon="Play24" Appearance="Primary" AutomationProperties.Name="Run the check"
                                   Command="{Binding RunHealthCommand, Mode=OneTime}" IsEnabled="{Binding HealthIdle, Mode=OneWay}" />
                    </Grid>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Health, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" Foreground="{Binding Color}" FontSize="20" Margin="0,1,12,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="{Binding FixLabel}" Icon="Wrench24" Visibility="{Binding FixVisibility}" Command="{Binding FixCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- ============================================================ connection -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Router24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_Connection}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ServerText, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="150" ItemsSource="{Binding DurationOptions, Mode=OneTime}" SelectedItem="{Binding SelectedDuration, Mode=TwoWay}" IsEnabled="{Binding ConnectionIdle, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_TestConnection}" Icon="Play24" Appearance="Primary" AutomationProperties.Name="Test the connection"
                                   Command="{Binding RunConnectionCommand, Mode=OneTime}" IsEnabled="{Binding ConnectionIdle, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_Stop}" Icon="Stop24" Appearance="Secondary" Command="{Binding CancelConnectionCommand, Mode=OneTime}" Visibility="{Binding ConnectionBusyVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding ConnectionProgress, Mode=OneWay}" Visibility="{Binding ConnectionBusyVisibility, Mode=OneWay}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ConnectionStatus, Mode=OneWay}" />

                    <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1" Visibility="{Binding ConnectionVerdictVisibility, Mode=OneWay}"
                            BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ConnectionVerdict, Mode=OneWay}" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ConnectionFindings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PingRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Address, Mode=OneWay}" /></TextBlock>
                                            <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Numbers}" />
                                        </StackPanel>
                                        <Canvas Grid.Column="1" Width="300" Height="40" ClipToBounds="True" VerticalAlignment="Center">
                                            <Polyline Points="{Binding Spark}" Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:CardExpander Margin="0,4,0,0" Header="{x:Static resources:Strings.Menu_Diagnostics_RouteStationByStation}">
                        <ItemsControl ItemsSource="{Binding RouteRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,1" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>

                    <TextBlock Margin="2,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_RobloxGameServersIgnorePingsSo}" />
                </StackPanel>
            </TabItem>
            <!-- ============================================================ crashes -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Bug24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_Crashes}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_WhenRobloxClosesWithoutItsNormal}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="{x:Static resources:Strings.Menu_Diagnostics_AnalyseLastSession}" Icon="Search24" Appearance="Primary" AutomationProperties.Name="Analyse the last session" Command="{Binding AnalyzeLastSessionCommand, Mode=OneTime}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Icon="ArrowClockwise24" Appearance="Secondary" Command="{Binding RefreshCrashesCommand, Mode=OneTime}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CrashStatus, Mode=OneWay}" />

                    <TextBlock Margin="2,14,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding CrashesEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_Diagnostics_NoCrashesRecord}" />

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Crashes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding When}" />
                                            <Border Grid.Column="1" Padding="8,2" CornerRadius="9" Background="{Binding ConfidenceColor}" Visibility="{Binding ConfidenceVisibility}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#101216" Text="{Binding Confidence}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Cause}" />

                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding SuggestionsVisibility}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Diagnostics_WhatTry}" />
                                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StringFormat='•  {0}'}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding EvidenceVisibility}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Diagnostics_Evidence}" />
                                            <ItemsControl ItemsSource="{Binding Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,3,0,0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:OptionControl Margin="0,8,0,0" Header="{x:Static resources:Strings.Menu_Diagnostics_LookIntoUnexpectedClosesAutomatically}" Description="{x:Static resources:Strings.Menu_Diagnostics_RunsAnalysisWhenRobloxEndsWithout}">
                        <ui:ToggleSwitch IsChecked="{Binding CrashAnalyzerEnabled, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </TabItem>
            <!-- ============================================================ stutter -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pulse24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_Stutter}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_TimesEveryFrameGameWhileWatches}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="150" ItemsSource="{Binding MeasureOptions, Mode=OneTime}" SelectedItem="{Binding SelectedMeasure, Mode=TwoWay}" IsEnabled="{Binding MeasureIdle, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_MeasureMyGame}" Icon="Play24" Appearance="Primary" AutomationProperties.Name="Measure my game" Command="{Binding RequestMeasureCommand, Mode=OneTime}" IsEnabled="{Binding MeasureIdle, Mode=OneWay}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" Icon="Dismiss24" Appearance="Secondary" AutomationProperties.Name="Cancel the measurement" Command="{Binding CancelMeasureCommand, Mode=OneTime}" Visibility="{Binding MeasurePendingVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding MeasureProgress, Mode=OneWay}" Visibility="{Binding MeasurePendingVisibility, Mode=OneWay}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MeasureStatusText, Mode=OneWay}" />

                    <TextBlock Margin="2,14,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding RunsEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_Diagnostics_NothingMeasuredYet}" />

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Runs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <ui:Button Grid.Column="1" Padding="4" Appearance="Transparent" Icon="Delete16" ToolTip="{x:Static resources:Strings.Menu_Diagnostics_DeleteMeasurement}" AutomationProperties.Name="Delete measurement"
                                                       Command="{Binding DataContext.DeleteRunCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Verdict}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Numbers}" />

                                        <Viewbox Margin="0,10,0,0" Stretch="Fill" Height="70" HorizontalAlignment="Stretch">
                                            <Canvas Width="900" Height="70" ClipToBounds="True">
                                                <Polyline Points="{Binding Graph}" Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GraphScale}" />

                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Findings}" Visibility="{Binding FindingsVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StringFormat='•  {0}'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- ============================================================ auto-tuner -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Beaker24" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Diagnostics_FastFlagAutoTuner}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_FindsOutWhetherFastFlagSetReally}" />

                    <!-- setup -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding TunerSetupVisibility, Mode=OneWay}">
                        <TextBlock FontSize="14" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_Diagnostics_WhichFlagSetsShouldBeCompared}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_TwoFourOtherSetsHaveExist}" />

                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TunerCandidates, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0,0,4" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock FontSize="13" Text="{Binding Title}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox Width="230" ItemsSource="{Binding TunerRoundOptions, Mode=OneTime}" SelectedItem="{Binding SelectedTunerRounds, Mode=TwoWay}" />
                            <ComboBox Width="190" Margin="8,0,0,0" ItemsSource="{Binding TunerLengthOptions, Mode=OneTime}" SelectedItem="{Binding SelectedTunerLength, Mode=TwoWay}" />
                            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_StartExperiment}" Icon="Beaker24" Appearance="Primary" AutomationProperties.Name="Start the experiment" Command="{Binding StartTunerCommand, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- running -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding TunerRunningVisibility, Mode=OneWay}">
                        <ItemsControl ItemsSource="{Binding TunerSteps, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{Binding Color}" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock FontSize="13" VerticalAlignment="Center" Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding TunerNextText, Mode=OneWay}" />
                                <ui:Button Margin="0,8,0,0" Content="{Binding TunerArmLabel, Mode=OneWay}" Icon="Flag24" Appearance="Primary" AutomationProperties.Name="Arm the next run" Visibility="{Binding TunerArmVisibility, Mode=OneWay}" Command="{Binding ArmTunerCommand, Mode=OneTime}" />
                                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MeasureStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding TunerResultsVisibility, Mode=OneWay}">
                            <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding TunerVerdict, Mode=OneWay}" />

                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_FLAGSET}" />
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_SLOWEST1}" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_AVERAGE}" />
                                <TextBlock Grid.Column="3" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_STUTTERS}" />
                                <TextBlock Grid.Column="4" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Diagnostics_RUNS}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TunerResults, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="{Binding Weight}" Text="{Binding Variant}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="{Binding Weight}" Text="{Binding Low}" />
                                            <TextBlock Grid.Column="2" FontSize="13" Text="{Binding Average}" />
                                            <TextBlock Grid.Column="3" FontSize="13" Text="{Binding Stutters}" />
                                            <TextBlock Grid.Column="4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Runs}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding TunerNotes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StringFormat='•  {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static resources:Strings.Menu_Diagnostics_EndExperimentKeep}" />
                            <ComboBox Width="320" ItemsSource="{Binding TunerKeepOptions, Mode=OneWay}" SelectedItem="{Binding SelectedTunerKeep, Mode=TwoWay}" />
                            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Diagnostics_Finish}" Icon="Checkmark24" AutomationProperties.Name="Finish the experiment" Command="{Binding FinishTunerCommand, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TunerMessage, Mode=OneWay}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</ui:UiPage>
