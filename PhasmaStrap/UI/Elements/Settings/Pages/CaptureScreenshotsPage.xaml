<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.CaptureScreenshotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:CaptureViewModel, IsDesignTimeCreatable=True}"
      Title="CaptureScreenshotsPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <Style x:Key="HotkeyCaptureButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Click, then press the key or combination. Esc cancels and keeps the current hotkey." />
        </Style>

        <Style x:Key="HotkeyStatusText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Capture_Screenshots}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Capture_ScreenshotsRobloxWindowSavedLocallyBind}" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="{x:Static resources:Strings.Menu_Capture_TakeScreenshotNow}" Icon="Camera24" Command="{Binding TakeScreenshotCommand, Mode=OneTime}" />
            <ui:Button Margin="8,0,0,0" Content="{Binding AllScreenshotsText}" Icon="ImageMultiple24" Appearance="Primary" ToolTip="{x:Static resources:Strings.Menu_Capture_EveryScreenshotSearchFiltersRename}" Command="{Binding OpenScreenshotLibraryCommand, Mode=OneTime}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Capture_OpenFolder}" Icon="Folder24" Appearance="Secondary" Command="{Binding OpenFolderCommand, Mode=OneTime}" />
        </StackPanel>

        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status, Mode=OneWay}" />

        <controls:OptionControl Header="Screenshot hotkey" Description="Press this while a game is running and the Roblox window is saved to your gallery.">
            <StackPanel Orientation="Horizontal">
                <ui:Button Uid="Capture" Content="{Binding ScreenshotHotkey.ButtonText}" Tag="{Binding ScreenshotHotkey}" Click="CaptureButton_Click">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource HotkeyCaptureButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScreenshotHotkey.IsListening}" Value="True">
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Margin="8,0,0,0" Focusable="False" Content="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}" Appearance="Secondary"
                           IsEnabled="{Binding ScreenshotHotkey.HasGesture}" Tag="{Binding ScreenshotHotkey}" Click="ClearButton_Click" />
            </StackPanel>
        </controls:OptionControl>

        <TextBlock Text="{Binding ScreenshotHotkey.StatusText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HotkeyStatusText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ScreenshotHotkey.HasStatus}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ScreenshotHotkey.StatusIsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_CopyNewScreenshotsClipboard}" Description="{x:Static resources:Strings.Menu_Capture_ScreenshotTakenHotkeyAlsoCopiedSo}">
            <ui:ToggleSwitch IsChecked="{Binding CopyScreenshotToClipboard, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_PickAreaWhenIPressScreenshot}" Description="{x:Static resources:Strings.Menu_Capture_GameFreezesScreenYouDragOver}">
            <ui:ToggleSwitch IsChecked="{Binding ScreenshotPickArea, Mode=TwoWay}" />
        </controls:OptionControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,24">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasScreenshots}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="Camera24" FontSize="48" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Capture_NoScreenshotsYet}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="16" Opacity="0.5" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding RecentHintVisibility}"
                   Text="{x:Static resources:Strings.Menu_Capture_LatestScreenshotsOpenAllScreenshotsSearch}" />
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecentScreenshots, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,10,10" Padding="0" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <ui:Card.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{x:Static resources:Strings.Common_Copy}" Command="{Binding Tag.CopyScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Menu_Capture_CopyFilePath}" Command="{Binding Tag.CopyScreenshotPathCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Link24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static resources:Strings.Common_Open}" Command="{Binding Tag.OpenScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Common_Edit}" Command="{Binding Tag.EditScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Common_Rename}" Command="{Binding Tag.RenameScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Rename24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.Menu_Capture_ShowFolder}" Command="{Binding Tag.RevealScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Share to the gallery" Command="{Binding Tag.ShareScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Share24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static resources:Strings.Common_Delete}" Command="{Binding Tag.DeleteScreenshotCommand}" CommandParameter="{Binding DataContext}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Card.ContextMenu>
                        <StackPanel>
                            <Border Height="140" CornerRadius="8,8,0,0" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TakenDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Margin="0,0,6,0" Padding="4" Appearance="Transparent" Icon="Copy16" ToolTip="{x:Static resources:Strings.Menu_Capture_CopyClipboardReadyPasteIntoChat}" AutomationProperties.Name="Copy screenshot"
                                               Command="{Binding DataContext.CopyScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Padding="6,4" Appearance="Secondary" Icon="Edit16" Content="{x:Static resources:Strings.Common_Edit}" ToolTip="{x:Static resources:Strings.Menu_Capture_CropDrawAddTextPixelateParts}"
                                               Command="{Binding DataContext.EditScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Margin="6,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16" ToolTip="{x:Static resources:Strings.Menu_Capture_DeleteScreenshot}"
                                               Command="{Binding DataContext.DeleteScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
