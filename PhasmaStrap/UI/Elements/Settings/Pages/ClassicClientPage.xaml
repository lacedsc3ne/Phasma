<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ClassicClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      Title="ClassicClientPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            Runs a private Roblox server on your own machine and points classic/legacy Roblox clients at it, by
            redirecting roblox.com to 127.0.0.1 in the Windows hosts file for the duration of a classic session.
            This is a significant change to how your machine resolves Roblox's real domain, so it is off by default
            and the redirect is only ever active while a classic client session is running.
        </TextBlock>

        <controls:OptionControl
            Header="Enable classic client support"
            Description="Master switch for this feature. Must be turned on before a classic client can be launched through PhasmaStrap."
            x:Name="ClassicClientEnabledOption">
            <ui:ToggleSwitch IsChecked="{Binding ClassicClientEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Installation" FontSize="20" FontWeight="Medium" Margin="0,16,0,0"
                   IsEnabled="{Binding InnerContent.IsChecked, ElementName=ClassicClientEnabledOption, Mode=OneWay}" />

        <StackPanel IsEnabled="{Binding InnerContent.IsChecked, ElementName=ClassicClientEnabledOption, Mode=OneWay}">
            <TextBlock Margin="0,4,0,0" Text="Install location" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="Leave blank to use the default location" Text="{Binding ClassicClientInstallLocation}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Height="34" Icon="Folder24" Content="Browse" Command="{Binding BrowseInstallLocationCommand}" />
            </Grid>

            <TextBlock Margin="0,12,0,0" Text="{Binding EngineStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding RedirectStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Installed clients" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding InstalledClients}" SelectedItem="{Binding SelectedClassicClient, Mode=TwoWay}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowSync24" Content="Refresh" Command="{Binding RefreshClientsCommand}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="Play24" Content="Launch selected client" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding LaunchClientCommand}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Stop24" Content="Stop private server" HorizontalAlignment="Stretch" Appearance="Danger" IsEnabled="{Binding IsServerRunning, Mode=OneWay}" Command="{Binding StopServerCommand}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
