<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ClassicClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="ClassicClientPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>
    <StackPanel Margin="0,0,14,14">
        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.Menu_ClassicClient_Description}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_ClassicClient_Enabled_Title}"
            Description="{x:Static resources:Strings.Menu_ClassicClient_Enabled_Description}"
            x:Name="ClassicClientEnabledOption">
            <ui:ToggleSwitch IsChecked="{Binding ClassicClientEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_ClassicClient_Installation_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0"
                   IsEnabled="{Binding InnerContent.IsChecked, ElementName=ClassicClientEnabledOption, Mode=OneWay}" />

        <StackPanel IsEnabled="{Binding InnerContent.IsChecked, ElementName=ClassicClientEnabledOption, Mode=OneWay}">
            <TextBlock Margin="0,4,0,0" Text="{x:Static resources:Strings.Menu_ClassicClient_InstallLocation_Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static resources:Strings.Menu_ClassicClient_InstallLocation_PlaceholderText}" Text="{Binding ClassicClientInstallLocation}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Height="34" Icon="Folder24" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseInstallLocationCommand}" />
            </Grid>

            <TextBlock Margin="0,12,0,0" Text="{Binding EngineStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding EngineDataStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding RedirectStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{x:Static resources:Strings.Menu_ClassicClient_AcquireClients_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static resources:Strings.Menu_ClassicClient_AcquireClients_Description}" />

            <ui:Button Margin="0,8,0,0" Icon="ArrowDownload24" Content="{x:Static resources:Strings.Menu_ClassicClient_InstallEngineDataPack}"
                       HorizontalAlignment="Stretch" IsEnabled="{Binding IsNotBusy, Mode=OneWay}"
                       Command="{Binding InstallEngineCommand}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableClients}" SelectedItem="{Binding SelectedAvailableClient, Mode=TwoWay}"
                          DisplayMemberPath="Name" IsEnabled="{Binding IsNotBusy, Mode=OneWay}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowDownload24" Content="{x:Static resources:Strings.Menu_ClassicClient_Install}"
                           IsEnabled="{Binding IsNotBusy, Mode=OneWay}"
                           Command="{Binding InstallSelectedClientCommand}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Icon="ArrowSync24" Content="{x:Static resources:Strings.Menu_ClassicClient_UpdateAll}"
                           HorizontalAlignment="Stretch" IsEnabled="{Binding IsNotBusy, Mode=OneWay}"
                           Command="{Binding UpdateAllCommand}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" Appearance="Danger"
                           IsEnabled="{Binding IsBusy, Mode=OneWay}" Command="{Binding CancelOperationCommand}" />
            </Grid>

            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ProgressText, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{x:Static resources:Strings.Menu_ClassicClient_InstalledClients_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding InstalledClients}" SelectedItem="{Binding SelectedClassicClient, Mode=TwoWay}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowSync24" Content="{x:Static resources:Strings.Menu_ClassicClient_Refresh}" Command="{Binding RefreshClientsCommand}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="Play24" Content="{x:Static resources:Strings.Menu_ClassicClient_LaunchSelectedClient}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding LaunchClientCommand}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Stop24" Content="{x:Static resources:Strings.Menu_ClassicClient_StopPrivateServer}" HorizontalAlignment="Stretch" Appearance="Danger" IsEnabled="{Binding IsServerRunning, Mode=OneWay}" Command="{Binding StopServerCommand}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
