<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RobloxVersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="RobloxVersionsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,14">
            <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_RobloxVersion}" FontSize="20" FontWeight="Medium" />
            <TextBlock Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static resources:Strings.Menu_RobloxVersions_NormallyPhasmaStrapInstallsEveryRobloxUpdate}" />

            <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding InstalledText}" />
                    <TextBlock Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LatestText}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,20,0,8" FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_RobloxVersions_WhichVersionUse}" />

            <Border Padding="14,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <RadioButton GroupName="RobloxVersionMode" Content="{x:Static resources:Strings.Menu_RobloxVersions_AlwaysNewestNormal}" IsChecked="{Binding ModeLatest, Mode=TwoWay}" />
                    <RadioButton Margin="0,6,0,0" GroupName="RobloxVersionMode" Content="{x:Static resources:Strings.Menu_RobloxVersions_StayVersionIHaveNowDon}" IsChecked="{Binding ModeHold, Mode=TwoWay}" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <RadioButton VerticalAlignment="Center" GroupName="RobloxVersionMode" Content="{x:Static resources:Strings.Menu_RobloxVersions_UseVersion}" IsChecked="{Binding ModePin, Mode=TwoWay}" />
                        <ComboBox Width="260" Margin="8,0,0,0" IsEnabled="{Binding ModePin}" ItemsSource="{Binding PinChoices}" DisplayMemberPath="Title" SelectedValuePath="Record.Guid" SelectedValue="{Binding PinnedVersion, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding WarningVisibility}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{x:Static resources:Strings.Menu_RobloxVersions_RobloxOnlyLetsRecentVersionsInto}" />
                    </Border>
                </StackPanel>
            </Border>

            <controls:OptionControl Margin="0,8,0,0" Header="{x:Static resources:Strings.Menu_RobloxVersions_KeepPreviousVersionAfterUpdate}"
                                    Description="{x:Static resources:Strings.Menu_RobloxVersions_RobloxWonTHandOutOld}">
                <ui:ToggleSwitch IsChecked="{Binding KeepPrevious, Mode=TwoWay}" />
            </controls:OptionControl>

            <TextBlock Margin="0,20,0,8" FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_RobloxVersions_VersionsPC}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NothingKeptVisibility}"
                       Text="{x:Static resources:Strings.Menu_RobloxVersions_OnlyVersionUseHereKeepPrevious}" />
            <ItemsControl ItemsSource="{Binding OnDisk}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Icon="Pin24" Content="{x:Static resources:Strings.Menu_RobloxVersions_UseVersion2}" VerticalAlignment="Center" Visibility="{Binding UseVisibility}"
                                           Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,20,0,8" FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_RobloxVersions_FlagsUpdates}" />

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_RobloxVersions_TellMeWhenUpdateRemovesFlags}"
                                    Description="{x:Static resources:Strings.Menu_RobloxVersions_AfterEachUpdateNewVersionCompared}">
                <ui:ToggleSwitch IsChecked="{Binding CheckFlags, Mode=TwoWay}" />
            </controls:OptionControl>

            <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding MissingFlagsVisibility}">
                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="{Binding MissingFlagsText}" />
            </Border>

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:Button Icon="BranchCompare24" Content="{x:Static resources:Strings.Menu_RobloxVersions_CompareOtherVersionPC}" Command="{Binding CompareCommand, Mode=OneTime}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CompareStatus}" />
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
