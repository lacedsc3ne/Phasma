<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.AssetEnginePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:AssetEngineViewModel, IsDesignTimeCreatable=False}"
      Title="AssetEnginePage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>
    <StackPanel Margin="0,0,14,14">
        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_LetsGameSAssetDownloadsTextures}" />

        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <TextBlock TextWrapping="Wrap" Text="{Binding StatusText, Mode=OneWay}" />
        </Border>

        <controls:OptionControl Margin="0,8,0,0" Header="{x:Static resources:Strings.Menu_AssetEngine_RouteAssetDownloadsThroughPhasmaStrap}" Description="{x:Static resources:Strings.Menu_AssetEngine_SwitchEverythingBelowExceptSwapPacks}">
            <ui:ToggleSwitch IsChecked="{Binding RouteEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================================================ cache -->
        <TextBlock Text="{x:Static resources:Strings.Menu_AssetEngine_AssetCache}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_KeepsDownloadedAssetsDiskAcrossSessions}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetEngine_KeepAssetsDisk}">
            <ui:ToggleSwitch IsChecked="{Binding CacheEnabled, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_SizeLimit}" Description="{Binding CacheUsage, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="120" ItemsSource="{Binding CacheLimitOptions, Mode=OneTime}" SelectedItem="{Binding SelectedCacheLimit, Mode=TwoWay}" />
                <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_AssetEngine_EmptyCache}" Icon="Delete24" Command="{Binding ClearCacheCommand, Mode=OneTime}" />
            </StackPanel>
        </controls:OptionControl>

        <Grid Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_AssetEngine_GamesPhasmaStrapKnowsAssets}" />
            <ui:Button Grid.Column="1" Content="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Icon="ArrowClockwise24" Appearance="Secondary" AutomationProperties.Name="Refresh the asset engine" Command="{Binding RefreshCommand, Mode=OneTime}" />
        </Grid>
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_PrefetchDownloadsWhatGameKnownUse}" />
        <TextBlock Margin="2,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding GamesEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_AssetEngine_NoneYetGameAppearsHereAfter}" />

        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Games, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                <ProgressBar Margin="0,6,0,0" Height="3" Minimum="0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" Content="{x:Static resources:Strings.Menu_AssetEngine_Prefetch}" Icon="ArrowDownload24" IsEnabled="{Binding CanPrefetch}"
                                       Command="{Binding DataContext.PrefetchCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PrefetchStatus, Mode=OneWay}" />

        <!-- ============================================================ shrinker -->
        <TextBlock Text="{x:Static resources:Strings.Menu_AssetEngine_TextureShrinker}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_ScalesLargeImagesDownTheirWay}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetEngine_ShrinkLargeImages}">
            <ui:ToggleSwitch IsChecked="{Binding ShrinkEnabled, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetEngine_LargestSide}" Description="{x:Static resources:Strings.Menu_AssetEngine_ImagesBiggerThanAreScaledDown}">
            <ComboBox Width="230" ItemsSource="{Binding ShrinkOptions, Mode=OneTime}" SelectedItem="{Binding SelectedShrink, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================================================ swap packs -->
        <TextBlock Text="{x:Static resources:Strings.Menu_AssetEngine_AssetSwapPacks}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_ReplaceAnySoundTextureSkyboxFace}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetEngine_UseSwapPacks}" Description="{x:Static resources:Strings.Menu_AssetEngine_WorksProxyAloneRoutingEverythingNot}">
            <ui:ToggleSwitch IsChecked="{Binding SwapsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:TextBox Width="240" PlaceholderText="{x:Static resources:Strings.Menu_AssetEngine_NameNewPack}" Text="{Binding NewPackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_AssetEngine_Create}" Icon="Add24" AutomationProperties.Name="Create swap pack" Command="{Binding CreatePackCommand, Mode=OneTime}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_AssetEngine_ImportPack}" Icon="ArrowImport24" Appearance="Secondary" Command="{Binding ImportPackCommand, Mode=OneTime}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_Capture_OpenFolder}" Icon="Folder24" Appearance="Secondary" Command="{Binding OpenPacksFolderCommand, Mode=OneTime}" />
        </StackPanel>

        <TextBlock Margin="2,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding PacksEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_AssetEngine_NoPacksYet}" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Packs, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Margin="0,0,0,6">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,12,0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static resources:Strings.Menu_AssetEngine_OnlyTheseGamesPlaceIDsEmpty}" />
                                <ui:TextBox Width="300" PlaceholderText="{x:Static resources:Strings.Menu_AssetEngine_EveryGame}" Text="{Binding Places, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Swaps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                            <ui:Button Grid.Column="1" Padding="4" Appearance="Transparent" Icon="Delete16" ToolTip="{x:Static resources:Strings.Menu_AssetEngine_RemoveReplacement}"
                                                       Command="{Binding DataContext.RemoveSwapCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="{x:Static resources:Strings.Menu_AssetEngine_Export}" Icon="ArrowExportLtr24" Appearance="Secondary"
                                           Command="{Binding DataContext.ExportPackCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                                <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_AssetEngine_DeletePack}" Icon="Delete24" Appearance="Secondary"
                                           Command="{Binding DataContext.DeletePackCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_AssetEngine_AddReplacement}" />
                <WrapPanel Margin="0,6,0,0">
                    <ComboBox Width="200" Margin="0,0,8,6" ItemsSource="{Binding Packs, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPack, Mode=TwoWay}" />
                    <ui:TextBox Width="170" Margin="0,0,8,6" PlaceholderText="{x:Static resources:Strings.Menu_DeveloperTools_AssetID}" Text="{Binding SwapAssetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox Width="220" Margin="0,0,8,6" PlaceholderText="{x:Static resources:Strings.Menu_AssetEngine_NoteOptional}" Text="{Binding SwapNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="0,0,0,6" Content="{x:Static resources:Strings.Menu_AssetEngine_ChooseFile}" Icon="DocumentAdd24" Command="{Binding AddSwapCommand, Mode=OneTime}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PackStatus, Mode=OneWay}" />

        <!-- ============================================================ server picker -->
        <TextBlock Text="{x:Static resources:Strings.Menu_AssetEngine_JoinTimeServerPicker}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_WhenGameJoinedWithoutNamingServer}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetEngine_LetMeChooseServerWhenI}">
            <ui:ToggleSwitch IsChecked="{Binding ServerPickerEnabled, Mode=TwoWay}" />
        </controls:OptionControl>
        <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PickerStatus, Mode=OneWay}" />

        <!-- ============================================================ traffic -->
        <TextBlock Text="{x:Static resources:Strings.Menu_AssetEngine_TrafficReport}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_AssetEngine_PerGameHowMuchWasDownloaded}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetEngine_KeepTrafficReport}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Margin="0,0,12,0" Content="{x:Static resources:Strings.Common_Reset}" Icon="Delete24" Appearance="Secondary" Command="{Binding ClearTrafficCommand, Mode=OneTime}" />
                <ui:ToggleSwitch IsChecked="{Binding TrafficEnabled, Mode=TwoWay}" />
            </StackPanel>
        </controls:OptionControl>

        <TextBlock Margin="2,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding TrafficEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_AssetEngine_NothingCountedYet}" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Traffic, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Numbers}" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Types}" />
                            <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Hosts}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
