<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RenderingPerGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="RenderingPerGamePage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_Performance_EnginePerGame_Header}" />
        <TextBlock Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Performance_EnginePerGame_Description}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_Performance_EngineExcludedPlaces_Title}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Performance_EngineExcludedPlaces_Description}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <ui:TextBox Width="200" PlaceholderText="{x:Static resources:Strings.Menu_Performance_EngineExcludedPlaces_PlaceholderText}" Text="{Binding EngineExcludePlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Common_AddSingle}" Command="{Binding AddEngineExcludedPlaceCommand, Mode=OneTime}" />
        </StackPanel>
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding EngineExcludedPlaces, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,6" Padding="8,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding}" FontFamily="Consolas" FontSize="12" />
                            <ui:Button Margin="8,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16" Command="{Binding DataContext.RemoveEngineExcludedPlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_Performance_EngineAssignments_Title}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Performance_EngineAssignments_Description}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <ui:TextBox Width="160" PlaceholderText="{x:Static resources:Strings.Menu_Performance_EngineAssignments_PlaceholderText}" Text="{Binding EngineAssignPlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding EnginePresetNames, Mode=OneTime}" SelectedItem="{Binding EngineAssignPresetName, Mode=TwoWay}" />
            <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Common_AddSingle}" Command="{Binding AddEngineProfileAssignmentCommand, Mode=OneTime}" />
        </StackPanel>
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding EngineProfileAssignments, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,6" Padding="8,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Display}" FontFamily="Consolas" FontSize="12" />
                            <ui:Button Margin="8,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16" Command="{Binding DataContext.RemoveEngineProfileAssignmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
