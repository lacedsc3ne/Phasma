<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:FriendsViewModel, IsDesignTimeCreatable=False}"
      Title="FriendsPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>
    <!-- The list is a virtualized ListBox filling the page (not a StackPanel-hosted ItemsControl):
         a few hundred friends only realise the rows that are on screen. -->
    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static resources:Strings.Menu_Friends_Friends}" FontSize="20" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Friends_WhoSOnlineWhatTheyRe}" />

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Friends_FriendActivityAlerts}" Description="{x:Static resources:Strings.Menu_Friends_ToastWhenFriendComesOnlineStarts}" x:Name="AlertsOption">
                <ui:ToggleSwitch IsChecked="{Binding AlertsEnabled, Mode=TwoWay}" />
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Friends_CheckEvery}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=AlertsOption, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <ui:NumberBox IntegersOnly="True" Width="100" Min="20" Max="600" Value="{Binding PollSeconds, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{x:Static resources:Strings.Menu_Friends_Seconds}" />
                </StackPanel>
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Friends_OnlyAlertFavourites}" Description="{x:Static resources:Strings.Menu_Friends_ToastsOnlyFriendsYouStarredBelow}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=AlertsOption, Mode=OneWay}">
                <ui:ToggleSwitch IsChecked="{Binding AlertFavouritesOnly, Mode=TwoWay}" />
            </controls:OptionControl>

            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_Friends_SearchNamesNotes}" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{x:Static resources:Strings.Menu_Friends_FavouritesOnly}" IsChecked="{Binding FavouritesOnly, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Margin="12,0,12,0" FontSize="12" Opacity="0.7" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{Binding Status}" />
                <ui:Button Grid.Column="3" Content="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Icon="ArrowClockwise24" Appearance="Secondary" Command="{Binding RefreshCommand, Mode=OneTime}" />
            </Grid>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Friends, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Margin="0,0,8,0" Padding="4" Width="32" Height="32" VerticalAlignment="Center" Focusable="False"
                                          Background="Transparent" BorderThickness="0" IsChecked="{Binding IsFavourite, Mode=TwoWay}"
                                          ToolTip="{x:Static resources:Strings.Menu_Friends_FavouriteKeepsFriendTopList}" AutomationProperties.Name="Favourite">
                                <ui:SymbolIcon Symbol="Star24" Filled="{Binding StarFilled}" FontSize="18">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StarFilled}" Value="True">
                                                    <Setter Property="Foreground" Value="#F5B301" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ToggleButton>

                            <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19" />
                                    </Image.Clip>
                                </Image>
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" StrokeThickness="2" Stroke="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Online">
                                                    <Setter Property="Fill" Value="#2ECC71" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="InGame">
                                                    <Setter Property="Fill" Value="#2ECC71" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="InStudio">
                                                    <Setter Property="Fill" Value="#3498DB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ui:TextBox Grid.Column="3" Width="240" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" MaxLength="200"
                                        PlaceholderText="{x:Static resources:Strings.Menu_Accounts_AddNote}" ClearButtonEnabled="False" ToolTip="{x:Static resources:Strings.Menu_Friends_OwnNoteAboutFriendOnlyStored}"
                                        Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=350}" />

                            <ui:Button Grid.Column="4" Margin="10,0,0,0" Content="{x:Static resources:Strings.Menu_ServerBrowser_Join}" Icon="ArrowRight24" Appearance="Primary" VerticalAlignment="Center"
                                       Visibility="{Binding Joinable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,24" Visibility="{Binding EmptyStateVisibility}">
            <ui:SymbolIcon Symbol="People24" FontSize="40" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Friends_NoFriendsShowYet}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" Opacity="0.5" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</ui:UiPage>
