<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NvidiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      Title="NvidiaPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Driver-level NVIDIA tweaks applied to a dedicated Roblox profile via NVAPI, separate from Roblox's own FastFlags or in-game settings. NVIDIA GPU required." FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Visibility="{Binding UnavailableVisibility}" Margin="0,16,0,0" Padding="14" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="NVIDIA GPU or driver not detected" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding AvailableVisibility}">
            <TextBlock Text="Latency &amp; framerate" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

            <controls:OptionControl Header="Low Latency Mode" Description="NVIDIA Reflex-style control panel setting that reduces input latency by limiting how far ahead the CPU can queue rendered frames.">
                <ComboBox Width="140" ItemsSource="{Binding LowLatencyModes, Mode=OneTime}" SelectedItem="{Binding LowLatencyMode, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="FRL Low Latency Mode" Description="Couples the frame rate limiter below to the driver's low-latency frame pacing path.">
                <ComboBox Width="140" ItemsSource="{Binding FrlLowLatencyModes, Mode=OneTime}" SelectedItem="{Binding FrlLowLatencyMode, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Frame rate limiter" Description="Driver-level frame cap for Roblox, in FPS. 0 leaves it uncapped.">
                <ui:NumberBox Width="140" Min="0" Max="1000" Value="{Binding FrameRateLimit, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Background frame rate limit" Description="Separate driver-level FPS cap applied only while Roblox is unfocused/minimized. 0 leaves it uncapped.">
                <ui:NumberBox Width="140" Min="0" Max="1000" Value="{Binding BackgroundFrameRateLimit, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Resizable BAR" Description="Lets the CPU access the entire GPU memory range at once instead of in small windows, if your system supports it.">
                <ui:ToggleSwitch IsChecked="{Binding ResizableBar, Mode=TwoWay}" />
            </controls:OptionControl>

            <TextBlock Text="Image quality" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

            <controls:OptionControl Header="DLSS Super Resolution override" Description="Forces the driver-level DLSS Super Resolution override on, independent of Roblox's own graphics settings.">
                <ui:ToggleSwitch IsChecked="{Binding DlssSuperResolution, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="DLSS Frame Generation override" Description="Forces the driver-level DLSS Frame Generation override on.">
                <ui:ToggleSwitch IsChecked="{Binding DlssFrameGeneration, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="MFAA" Description="Multi-Frame sampled Anti-Aliasing, a driver-level AA technique layered on top of whatever AA Roblox itself applies.">
                <ui:ToggleSwitch IsChecked="{Binding Mfaa, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="FXAA" Description="Driver-level Fast Approximate Anti-Aliasing, applied as a post-process pass regardless of Roblox's in-game AA setting.">
                <ui:ToggleSwitch IsChecked="{Binding Fxaa, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Gamma correction" Description="Applies gamma-correct antialiasing/blending at the driver level for more accurate colors during AA.">
                <ui:ToggleSwitch IsChecked="{Binding GammaCorrection, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="SILK smoothness" Description="NVIDIA's driver-level frame smoothing/pacing filter.">
                <ComboBox Width="140" ItemsSource="{Binding SilkSmoothnessModes, Mode=OneTime}" SelectedItem="{Binding SilkSmoothness, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Texture filtering LOD bias" Description="{Binding TextureLodBiasLabel}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="-32" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TextureLodBias, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding TextureLodBias, Mode=OneWay}" />
                </StackPanel>
            </controls:OptionControl>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="Apply to driver" Appearance="Primary" Click="Apply_Click" x:Name="ApplyButton" />
                <ui:Button Content="Reload from driver" Margin="8,0,0,0" Click="Reload_Click" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>
