<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NvidiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="NvidiaPage"
      Scrollable="True"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Visibility="{Binding UnavailableVisibility}" Margin="0,16,0,0" Padding="14" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_Unavailable_Title}" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Collapsed-card view: curated toggles + custom settings list. Swapped in place for
             EditorView below (same page/DataContext) whenever NvidiaEditorViewMode is false. -->
        <StackPanel Visibility="{Binding AvailableVisibility}">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NvidiaEditorViewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ui:CardAction Margin="0,16,0,0" Icon="Edit24" Click="AdvancedEditor_Click">
                    <StackPanel>
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Nvidia_AdvancedEditor_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Nvidia_AdvancedEditor_Description}" Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,8,0,0" Icon="Phone24" Click="NvidiaSetup_Click">
                    <StackPanel>
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Nvidia_Setup_Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Nvidia_Setup_Description}" Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="{x:Static resources:Strings.Menu_Nvidia_ApplyCard_Title}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Nvidia_ApplyCard_Description}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="{x:Static resources:Strings.Menu_Nvidia_ApplyButton}" Appearance="Primary" Icon="CheckmarkCircle24" Click="Apply_Click" x:Name="ApplyButton" />
            </Grid>

            <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_FastFlagsHeader}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Nvidia_GameDetails_Title}" />
                        <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Nvidia_GameDetails_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_FrameRateLimit_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_FrameRateLimit_Description}">
                        <ui:NumberBox Width="140" Min="0" Max="1000" Value="{Binding FrameRateLimit, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_BackgroundFrameRateLimit_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_BackgroundFrameRateLimit_Description}">
                        <ui:NumberBox Width="140" Min="0" Max="1000" Value="{Binding BackgroundFrameRateLimit, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_BenchmarkOverlay_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_BenchmarkOverlay_Description}">
                        <ComboBox Width="280" ItemsSource="{Binding BenchmarkOverlayModes, Mode=OneTime}" SelectedItem="{Binding BenchmarkOverlayMode, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_DlssSuperResolution_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_DlssSuperResolution_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding DlssSuperResolution, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_DlssFrameGeneration_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_DlssFrameGeneration_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding DlssFrameGeneration, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Nvidia_LatencyFramerate}" />
                        <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Nvidia_LowLatencyModes_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_LowLatencyMode_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_LowLatencyMode_Description}">
                        <ComboBox Width="140" ItemsSource="{Binding LowLatencyModes, Mode=OneTime}" SelectedItem="{Binding LowLatencyMode, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_FrlLowLatencyMode_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_FrlLowLatencyMode_Description}">
                        <ComboBox Width="140" ItemsSource="{Binding FrlLowLatencyModes, Mode=OneTime}" SelectedItem="{Binding FrlLowLatencyMode, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Nvidia_HardwareOverrides_Title}" />
                        <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Nvidia_HardwareOverrides_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_ResizableBar_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_ResizableBar_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding ResizableBar, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_Mfaa_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_Mfaa_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding Mfaa, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_Fxaa_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_Fxaa_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding Fxaa, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_GammaCorrection_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_GammaCorrection_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding GammaCorrection, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_SilkSmoothness_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_SilkSmoothness_Description}">
                        <ComboBox Width="140" ItemsSource="{Binding SilkSmoothnessModes, Mode=OneTime}" SelectedItem="{Binding SilkSmoothness, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_TextureLodBias_Title}" Description="{Binding TextureLodBiasLabel}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="200" Minimum="-32" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TextureLodBias, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding TextureLodBias, Mode=OneWay}" />
                        </StackPanel>
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_Title}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8" />

            <ItemsControl ItemsSource="{Binding CustomSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HexId}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Value}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static resources:Strings.Common_Delete}" Tag="{Binding}" Click="RemoveCustomSetting_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_Empty}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CustomSettings.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_AddButton}" Icon="AddCircle24" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddCustomSetting_Click" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_ReloadButton}" Click="Reload_Click" />
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_ExportNipButton}" Margin="8,0,0,0" Click="ExportNip_Click" />
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_CopySettingsButton}" Margin="8,0,0,0" Click="CopySettings_Click" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Advanced Editor (raw grid) view: same DataContext, swapped in place of the card
                 view above whenever NvidiaEditorViewMode is true. Mirrors FastFlagEditorPage's
                 search box + DataGrid + add/delete toolbar idiom, adapted to NVIDIA's
                 Type/Name/Setting ID/Value columns and multi-row selection. -->
            <Grid Margin="0,16,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NvidiaEditorViewMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,0,0,12" Text="{x:Static resources:Strings.Menu_Nvidia_Editor_Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <ui:Button Icon="Add28" Content="{x:Static resources:Strings.Menu_FastFlagEditor_AddNew}" Click="AddCustomSetting_Click" Margin="0,0,12,12" />
                    <ui:Button x:Name="DeleteSelectedButton" Icon="Delete48" Appearance="Danger" Content="{x:Static resources:Strings.Menu_FastFlagEditor_DeleteSelected}" Click="DeleteSelectedSettings_Click" Margin="0,0,12,12">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=NvidiaEditorGrid, Path=SelectedItems.Count}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Icon="Broom24" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_DeleteAll}" Click="DeleteAllSettings_Click" Margin="0,0,12,12" />
                    <ui:Button x:Name="ResetNipButton" Icon="ArrowReset24" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_ResetNip}" Click="ResetNip_Click" Margin="0,0,12,12" />
                    <ui:Button x:Name="ApplyButtonGrid" Icon="CheckmarkCircle24" Appearance="Primary" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_ApplyButton}" Click="Apply_Click" Margin="0,0,12,12" />
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="EditorSearchTextBox" Grid.Column="0" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Menu_Nvidia_Editor_Search}" TextChanged="EditorSearchTextBox_TextChanged" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding CustomSettings.Count, StringFormat={x:Static resources:Strings.Menu_Nvidia_Editor_FlagsAdded}}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ElementName=NvidiaEditorGrid, Path=SelectedItems.Count, StringFormat={x:Static resources:Strings.Menu_Nvidia_Editor_Selected}}" />
                </Grid>

                <Grid Grid.Row="3">
                    <DataGrid Name="NvidiaEditorGrid" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" IsReadOnly="True" SelectionMode="Extended">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="8,0,8,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource TextOnAccentFillColorPrimary}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static resources:Strings.Menu_Nvidia_Editor_Column_Type}" Binding="{Binding Type}" Width="Auto" />
                            <DataGridTextColumn Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{x:Static resources:Strings.Menu_Nvidia_Editor_Column_SettingId}" Binding="{Binding HexId}" Width="Auto" />
                            <DataGridTextColumn Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CustomSettings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="Flag24" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,8,0,0" Text="{x:Static resources:Strings.Menu_Nvidia_Editor_EmptyState}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_ExportNipButton}" Click="ExportNip_Click" />
                    <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_CopySettingsButton}" Margin="8,0,0,0" Click="CopySettings_Click" />
                    <ui:Button Icon="ArrowLeft48" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Back}" Margin="8,0,0,0" Click="AdvancedEditorBack_Click" />
                </StackPanel>

                <ui:CardExpander Grid.Row="5" Margin="0,16,0,0">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0" />
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Nvidia_Editor_History_Title}" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_Editor_History_ClearButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ClearFlagHistory_Click" />

                        <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_Editor_History_Empty}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FlagHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding FlagHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:CardExpander>
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
