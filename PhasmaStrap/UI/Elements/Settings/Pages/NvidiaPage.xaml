<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NvidiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="NvidiaPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Visibility="{Binding UnavailableVisibility}" Margin="0,16,0,0" Padding="14" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_Unavailable_Title}" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding AvailableVisibility}">
            <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_LatencyFramerate}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_LowLatencyMode_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_LowLatencyMode_Description}">
                <ComboBox Width="140" ItemsSource="{Binding LowLatencyModes, Mode=OneTime}" SelectedItem="{Binding LowLatencyMode, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_FrlLowLatencyMode_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_FrlLowLatencyMode_Description}">
                <ComboBox Width="140" ItemsSource="{Binding FrlLowLatencyModes, Mode=OneTime}" SelectedItem="{Binding FrlLowLatencyMode, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_FrameRateLimit_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_FrameRateLimit_Description}">
                <ui:NumberBox Width="140" Min="0" Max="1000" Value="{Binding FrameRateLimit, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_BackgroundFrameRateLimit_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_BackgroundFrameRateLimit_Description}">
                <ui:NumberBox Width="140" Min="0" Max="1000" Value="{Binding BackgroundFrameRateLimit, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_ResizableBar_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_ResizableBar_Description}">
                <ui:ToggleSwitch IsChecked="{Binding ResizableBar, Mode=TwoWay}" />
            </controls:OptionControl>

            <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_ImageQuality}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_DlssSuperResolution_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_DlssSuperResolution_Description}">
                <ui:ToggleSwitch IsChecked="{Binding DlssSuperResolution, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_DlssFrameGeneration_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_DlssFrameGeneration_Description}">
                <ui:ToggleSwitch IsChecked="{Binding DlssFrameGeneration, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_Mfaa_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_Mfaa_Description}">
                <ui:ToggleSwitch IsChecked="{Binding Mfaa, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_Fxaa_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_Fxaa_Description}">
                <ui:ToggleSwitch IsChecked="{Binding Fxaa, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_GammaCorrection_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_GammaCorrection_Description}">
                <ui:ToggleSwitch IsChecked="{Binding GammaCorrection, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_SilkSmoothness_Title}" Description="{x:Static resources:Strings.Menu_Nvidia_SilkSmoothness_Description}">
                <ComboBox Width="140" ItemsSource="{Binding SilkSmoothnessModes, Mode=OneTime}" SelectedItem="{Binding SilkSmoothness, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_TextureLodBias_Title}" Description="{Binding TextureLodBiasLabel}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="-32" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TextureLodBias, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding TextureLodBias, Mode=OneWay}" />
                </StackPanel>
            </controls:OptionControl>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_ApplyButton}" Appearance="Primary" Click="Apply_Click" x:Name="ApplyButton" />
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_ReloadButton}" Margin="8,0,0,0" Click="Reload_Click" />
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_ExportNipButton}" Margin="8,0,0,0" Click="ExportNip_Click" />
                <ui:Button Content="{x:Static resources:Strings.Menu_Nvidia_CopySettingsButton}" Margin="8,0,0,0" Click="CopySettings_Click" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>
