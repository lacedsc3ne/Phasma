<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:InstancesViewModel, IsDesignTimeCreatable=False}"
      Title="InstancesPage"
      Scrollable="True"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Instances" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Run more than one Roblox window at once. Roblox normally refuses to start a second copy of itself - launching here closes its singleton lock from the outside (no code runs inside Roblox's process) so a new window can open anyway. This is unofficial; Roblox could change how it enforces this at any time." />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Text="Only the first instance in a session gets a Watcher (Discord Rich Presence, hotkeys, overlays, auto-rejoin) - additional windows are plain Roblox, and all windows sign in as whichever account is currently active on this PC. Assigning a different account per window isn't supported yet." />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="12" Opacity="0.75" VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" />
            <ui:Button Grid.Column="1" Content="Refresh" Icon="ArrowClockwise24" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding RefreshCommand, Mode=OneTime}" />
            <ui:Button Grid.Column="2" Content="Launch new instance" Icon="WindowNew24" Appearance="Primary" Margin="8,0,0,0" IsEnabled="{Binding CanLaunch, Mode=OneWay}" Command="{Binding LaunchInstanceCommand, Mode=OneTime}" />
        </Grid>

        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Instances, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <Run Text="PID " /><Run Text="{Binding ProcessId, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Opacity="0.7">
                                    <Run Text="{Binding UptimeDisplay, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding MemoryDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Focus" Icon="WindowArrowUp24" Appearance="Secondary" Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <ui:Button Content="Close" Icon="Dismiss24" Appearance="Danger" Margin="8,0,0,0" Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,24" Visibility="{Binding EmptyStateVisibility}">
            <ui:SymbolIcon Symbol="WindowMultiple20" FontSize="40" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="No Roblox windows are running" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" Opacity="0.5" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>
