<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.DeveloperToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:DeveloperToolsViewModel, IsDesignTimeCreatable=True}"
      Title="DeveloperToolsPage"
      Scrollable="True"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Developer Tools" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="FastFlag snapshots/diffing, live proxy traffic, combined log viewer, and a plugin installer - all in one place for power users and troubleshooting." />

        <ui:CardExpander Margin="0,12,0,0" Icon="Flag24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="FastFlag snapshots" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Save your current flag set, flip between two saved sets to A/B compare, or diff any two snapshots." />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Width="220" PlaceholderText="Snapshot name" Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0" Content="Save current as snapshot" Icon="Save24" Command="{Binding SaveSnapshotCommand, Mode=OneTime}" />
                </StackPanel>

                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Snapshots, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" Text="{Binding Name}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding FlagCount, Mode=OneWay}" /><Run Text=" flag(s) • saved " /><Run Text="{Binding CreatedDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Apply" Appearance="Secondary"
                                               Command="{Binding DataContext.ApplySnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16"
                                               Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Compare two snapshots" FontSize="14" FontWeight="Medium" Margin="0,16,0,4" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="180" ItemsSource="{Binding Snapshots, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSnapshotA, Mode=TwoWay}" />
                    <TextBlock Text=" vs " VerticalAlignment="Center" Margin="8,0" />
                    <ComboBox Width="180" ItemsSource="{Binding Snapshots, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSnapshotB, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DiffSummary, Mode=OneWay}" />

                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DiffEntries, Mode=OneWay}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Width="60" Text="{Binding ChangeType}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding OldValue, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding NewValue, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="ArrowSwap24">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="Live proxy traffic" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Requests handled by the local proxy running in this window - launched Roblox sessions run their own separate proxy instance and won't show up here." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Content="Refresh" Icon="ArrowClockwise24" Command="{Binding RefreshProxyTrafficCommand, Mode=OneTime}" />
                        <ui:Button Content="Clear" Icon="Delete24" Appearance="Secondary" Command="{Binding ClearProxyTrafficCommand, Mode=OneTime}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding ProxyTraffic, Mode=OneWay}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" Width="60" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" />
                            <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding OutcomeDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="DocumentText24">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="14" Text="Log viewer" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Copy" Icon="Copy24" Appearance="Secondary" Command="{Binding CopyLogsCommand, Mode=OneTime}" />
                        <ui:Button Margin="8,0,0,0" Content="Refresh" Icon="ArrowClockwise24" Command="{Binding RefreshLogsCommand, Mode=OneTime}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="300">
                    <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding LogText, Mode=OneWay}" TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="PuzzleCube24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Studio plugin installer" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Install any Studio plugin by its Roblox asset ID." />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Width="160" PlaceholderText="Asset ID" Text="{Binding PluginAssetId, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0" Content="Install" Icon="ArrowDownload24" Command="{Binding InstallPluginCommand, Mode=OneTime}" />
                    <ui:Button Margin="8,0,0,0" Content="Open Plugins folder" Appearance="Secondary" Icon="Folder24" Command="{Binding OpenPluginsFolderCommand, Mode=OneTime}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PluginInstallStatus, Mode=OneWay}" />
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</ui:UiPage>
