<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.DeveloperToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:DeveloperToolsViewModel, IsDesignTimeCreatable=True}"
      Title="DeveloperToolsPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_DeveloperTools_DeveloperTools}" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_DeveloperTools_FastFlagSnapshotsDiffingLiveProxyTraffic}" />

        <ui:CardExpander Margin="0,12,0,0" Icon="Flag24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_DeveloperTools_FastFlagSnapshots}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_DeveloperTools_SaveCurrentFlagSetFlipBetween}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Width="220" PlaceholderText="{x:Static resources:Strings.Menu_DeveloperTools_SnapshotName}" Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_DeveloperTools_SaveCurrentAsSnapshot}" Icon="Save24" Command="{Binding SaveSnapshotCommand, Mode=OneTime}" />
                </StackPanel>

                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Snapshots, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" Text="{Binding Name}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding FlagCount, Mode=OneWay}" /><Run Text="{x:Static resources:Strings.Menu_DeveloperTools_FlagSSaved}" /><Run Text="{Binding CreatedDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static resources:Strings.Dialog_GoogleFonts_Apply}" Appearance="Secondary"
                                               Command="{Binding DataContext.ApplySnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="4" Appearance="Transparent" Icon="Delete16"
                                               Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static resources:Strings.Menu_DeveloperTools_CompareTwoSnapshots}" FontSize="14" FontWeight="Medium" Margin="0,16,0,4" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="180" ItemsSource="{Binding Snapshots, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSnapshotA, Mode=TwoWay}" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_DeveloperTools_Vs}" VerticalAlignment="Center" Margin="8,0" />
                    <ComboBox Width="180" ItemsSource="{Binding Snapshots, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSnapshotB, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DiffSummary, Mode=OneWay}" />

                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DiffEntries, Mode=OneWay}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220" controls:ScrollBubbling.Enabled="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Width="60" Text="{Binding ChangeType}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding OldValue, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding NewValue, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="ArrowSwap24">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_DeveloperTools_LiveProxyTraffic}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_DeveloperTools_RequestsHandledByLocalProxyRunning}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Content="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Icon="ArrowClockwise24" Command="{Binding RefreshProxyTrafficCommand, Mode=OneTime}" />
                        <ui:Button Content="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}" Icon="Delete24" Appearance="Secondary" Command="{Binding ClearProxyTrafficCommand, Mode=OneTime}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding ProxyTraffic, Mode=OneWay}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240" controls:ScrollBubbling.Enabled="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" Width="60" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" />
                            <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding OutcomeDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="DocumentText24">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="14" Text="{x:Static resources:Strings.Menu_DeveloperTools_LogViewer}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="{x:Static resources:Strings.Common_Copy}" Icon="Copy24" Appearance="Secondary" Command="{Binding CopyLogsCommand, Mode=OneTime}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Icon="ArrowClockwise24" Command="{Binding RefreshLogsCommand, Mode=OneTime}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="300" controls:ScrollBubbling.Enabled="True">
                    <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding LogText, Mode=OneWay}" TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,8,0,0" Icon="PuzzleCube24">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_DeveloperTools_StudioPluginInstaller}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_DeveloperTools_InstallAnyStudioPluginByIts}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Width="160" PlaceholderText="{x:Static resources:Strings.Menu_DeveloperTools_AssetID}" Text="{Binding PluginAssetId, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Installer_Install_Title}" Icon="ArrowDownload24" Command="{Binding InstallPluginCommand, Mode=OneTime}" />
                    <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_DeveloperTools_OpenPluginsFolder}" Appearance="Secondary" Icon="Folder24" Command="{Binding OpenPluginsFolderCommand, Mode=OneTime}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PluginInstallStatus, Mode=OneWay}" />
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</ui:UiPage>
