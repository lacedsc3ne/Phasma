<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.PartyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      Title="PartyPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <StackPanel Margin="0,0,14,14">
        <TextBlock FontSize="20" FontWeight="Medium" Text="Party" />
        <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding Status, Mode=OneWay}" />

        <ui:InfoBar Margin="0,10,0,0" IsOpen="True" Severity="Informational" Visibility="{Binding SignedOutVisibility, Mode=OneWay}"
                    Title="Not signed in"
                    Message="A party needs a PhasmaStrap account so everyone can be told where to go. Sign in on the PhasmaStrap page." />

        <controls:OptionControl Margin="0,12,0,0" Header="Parties" Description="Lets you share a code, follow a leader into games, and be invited by friends.">
            <ui:ToggleSwitch IsChecked="{Binding PartyEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Keep listening in the background"
                                Description="Runs a small PhasmaStrap process so your party can pull you in even when nothing is open. Turning this off means you only get pulled in while PhasmaStrap is open."
                                IsEnabled="{Binding PartyEnabled, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding PartyBackgroundEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="When the leader starts a game"
                                Description="What happens on your machine when the party leader launches."
                                IsEnabled="{Binding PartyEnabled, Mode=OneWay}">
            <ComboBox Width="240" Padding="10,5,10,5" ItemsSource="{Binding JoinModeOptions, Mode=OneTime}" SelectedIndex="{Binding JoinModeIndex, Mode=TwoWay}" />
        </controls:OptionControl>

        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Invites, Mode=OneWay}" Visibility="{Binding InvitesVisibility, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Text="{Binding Summary}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="Join" Appearance="Primary"
                                           Command="{Binding DataContext.AcceptInviteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Margin="8,0,0,0" Content="No thanks"
                                           Command="{Binding DataContext.DeclineInviteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{Binding NoPartyVisibility, Mode=OneWay}">
            <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="Start or join" />

            <controls:OptionControl Header="Start a party" Description="You become the leader and get a code to share.">
                <ui:Button Icon="PeopleTeam24" Content="Start a party" Appearance="Primary" Command="{Binding StartPartyCommand}" IsEnabled="{Binding PartyEnabled, Mode=OneWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Join with a code" Description="Type the six character code someone shared with you.">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Width="140" MaxLength="6" CharacterCasing="Upper" Text="{Binding JoinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0" Content="Join" Command="{Binding JoinPartyCommand}" IsEnabled="{Binding PartyEnabled, Mode=OneWay}" />
                </StackPanel>
            </controls:OptionControl>
        </StackPanel>

        <StackPanel Visibility="{Binding InPartyVisibility, Mode=OneWay}">
            <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="Your party" />

            <controls:OptionControl Header="Party code" Description="Anyone with this can join.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="18" Text="{Binding Code, Mode=OneWay}" />
                    <ui:Button Margin="12,0,0,0" Icon="Copy24" Content="Copy" Command="{Binding CopyCodeCommand}" />
                    <ui:Button Margin="8,0,0,0" Icon="DoorArrowRight20" Content="Leave" Command="{Binding LeavePartyCommand}" />
                </StackPanel>
            </controls:OptionControl>

            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Members, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Role}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Message, Mode=OneWay}" />
    </StackPanel>
</ui:UiPage>
