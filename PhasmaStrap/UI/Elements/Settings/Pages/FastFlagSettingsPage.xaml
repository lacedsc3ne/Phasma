<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.FastFlagSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="900"
      Title="FastFlagSettingsPage"
      Scrollable="False">
    <controls:SectionHost x:Name="Host" Margin="0,4,0,0">
        <controls:SectionItem Label="Roblox FFlags" PageType="{x:Type pages:FastFlagsPage}" />
        <controls:SectionItem Label="Flag editor" PageType="{x:Type pages:FastFlagEditorPage}" />
        <controls:SectionItem Label="Per-game flags" PageType="{x:Type pages:FastFlagGamesPage}" />
        <controls:SectionItem Label="Asset Warp" PageType="{x:Type pages:AssetWarpPage}" />
    </controls:SectionHost>
</ui:UiPage>
