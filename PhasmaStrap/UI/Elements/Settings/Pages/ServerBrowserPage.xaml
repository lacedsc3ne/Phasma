<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ServerBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ServerBrowserViewModel, IsDesignTimeCreatable=True}"
      Title="ServerBrowserPage"
      Scrollable="False">
    <!-- two tabs: the public server browser (below) and your private servers (its own page) -->
    <TabControl Margin="0,0,14,14">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Server24" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_ServerBrowser_BrowseServers}" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,14">
        <!-- The automatic matchmaker (enable/prefer-empty/preferred datacenter/candidate count/
             allow-block grid/excluded games) moved to the Behaviour page's "Matchmaker" tab, to
             match Voidstrap's grouping - see BehaviourViewModel.Matchmaker, which binds to this
             same ServerBrowserViewModel type so no logic was duplicated. This page now only
             holds the manual "search a place id, then join a specific server" browser below. -->
        <TextBlock Text="{x:Static resources:Strings.Menu_ServerBrowser_Browser_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_ServerBrowser_Browser_Description}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox Width="200" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_PlaceholderText}" Text="{Binding PlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Margin="8,0,0,0" Content="{x:Static resources:Strings.Menu_ServerBrowser_Search}" Icon="Search24" Command="{Binding SearchCommand, Mode=OneTime}" />
            </StackPanel>
        </controls:OptionControl>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button Grid.Column="1" Content="{x:Static resources:Strings.Menu_ServerBrowser_JoinFastest}" Icon="TopSpeed24" Appearance="Secondary"
                       IsEnabled="{Binding HasPingedServers, Mode=OneWay}"
                       Command="{Binding JoinFastestCommand, Mode=OneTime}"
                       ToolTip="{x:Static resources:Strings.Menu_ServerBrowser_JoinsWhicheverServerAboveReportedLowest}" />
        </Grid>

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Servers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding JobId}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Text="{Binding PlayersText}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="{Binding PingText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Grid.Column="3" Content="{x:Static resources:Strings.Menu_ServerBrowser_Join}" Appearance="Primary" Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_PrivateServers_PrivateServers}" />
                </StackPanel>
            </TabItem.Header>
            <Frame Margin="0,10,0,0"
                   Source="PrivateServersPage.xaml"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal"
                   Background="Transparent" />
        </TabItem>
    </TabControl>
</ui:UiPage>
