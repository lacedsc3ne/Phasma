<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
             xmlns:installerpages="clr-namespace:PhasmaStrap.UI.Elements.Installer.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:PhasmaStrap.Resources"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="1000"
             Width="1116"
             Height="638"
             ExtendsContentIntoTitleBar="True"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed"
             Loaded="MainWindow_MistLoaded">

    <Window.Resources>
        <BlurEffect x:Key="MistBlurLarge" Radius="70" />

        <Storyboard x:Key="MistDrift" Timeline.DesiredFrameRate="30" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="X"
                From="-80" To="100" Duration="0:0:14" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="Y"
                From="30" To="-40" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="X"
                From="90" To="-110" Duration="0:0:16" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="Y"
                From="-40" To="35" Duration="0:0:12.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <ControlTemplate x:Key="NarrowNavigationFluent" TargetType="{x:Type ui:NavigationFluent}">
            <ui:DynamicScrollViewer Margin="0" Padding="0" HorizontalScrollBarVisibility="Disabled">
                <ui:DynamicScrollViewer.Resources>
                    <Style TargetType="{x:Type ui:DynamicScrollBar}" BasedOn="{StaticResource {x:Type ui:DynamicScrollBar}}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.35" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:DynamicScrollViewer.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl
                        Grid.Row="0"
                        Focusable="False"
                        ItemsSource="{TemplateBinding Items}"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="0" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl
                        Grid.Row="1"
                        Focusable="False"
                        ItemsSource="{TemplateBinding Footer}"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="0" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </ui:DynamicScrollViewer>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse x:Name="Mist1" Width="480" Height="480" Canvas.Left="-160" Canvas.Top="-200" Opacity="0.12" Effect="{StaticResource MistBlurLarge}" Fill="{DynamicResource BackgroundGlowPrimaryBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate1" X="-80" Y="30" />
                </Ellipse.RenderTransform>
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#8F000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
            <Ellipse x:Name="Mist2" Width="420" Height="420" Canvas.Left="620" Canvas.Top="120" Opacity="0.15" Effect="{StaticResource MistBlurLarge}" Fill="{DynamicResource BackgroundGlowSecondaryBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate2" X="90" Y="-40" />
                </Ellipse.RenderTransform>
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
        </Canvas>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Icon="Info20" Timeout="10000" Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="10" />

        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Appearance="Success" Icon="CheckmarkCircle32" Timeout="3000" Margin="200,0,200,84" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.Menu_Title}" Icon="pack://application:,,,/PhasmaStrap.ico" />

        <Button x:Name="AccountButton" Grid.Row="0" Panel.ZIndex="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,146,0" Padding="9,5" Background="Transparent" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Cursor="Hand"
                Click="AccountButton_Click" ToolTip="Sign in to PhasmaStrap">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="AccountAvatar" Width="20" Height="20" CornerRadius="10" Visibility="Collapsed" Margin="0,0,7,0">
                    <Border.Background>
                        <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <ui:SymbolIcon x:Name="AccountIcon" Symbol="Person24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="AccountLabel" VerticalAlignment="Center" FontSize="13" Text="Log in" />
                <ui:SymbolIcon x:Name="AccountChevron" Symbol="ChevronDown24" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu x:Name="AccountMenu">
                    <MenuItem x:Name="AccountWhoItem" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="Account settings" Click="AccountSettings_Click" />
                    <MenuItem Header="Open my profile on the website" Click="AccountWebsite_Click" />
                    <Separator />
                    <MenuItem Header="Sign out" Click="AccountSignOut_Click" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="12,12,0,0" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Margin="-6,-6,6,8" CornerRadius="10"
                    Background="{DynamicResource SidebarBackgroundBrush}" IsHitTestVisible="False" />

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="SidebarToggle" Grid.Column="0" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                           Icon="PanelLeftContract24" Appearance="Transparent" Click="SidebarToggle_Click"
                           ToolTip="Collapse the sidebar" AutomationProperties.Name="Collapse the sidebar" />

                <ui:TextBox
                    Grid.Column="1"
                    x:Name="SettingsSearchBox"
                    PlaceholderText="{x:Static resources:Strings.Menu_Settings_SearchPlaceholder}"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    TextChanged="SettingsSearchBox_TextChanged"
                    PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"
                    GotKeyboardFocus="SettingsSearchBox_GotKeyboardFocus"
                    LostKeyboardFocus="SettingsSearchBox_LostKeyboardFocus" />

                <Popup x:Name="SettingsSearchPopup"
                       PlacementTarget="{Binding ElementName=SettingsSearchBox}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Focusable="False">
                    <Border Width="480" MaxHeight="440" Margin="0,0,8,8"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
                        </Border.Effect>
                        <DockPanel>
                            <TextBlock x:Name="SettingsSearchFooter" DockPanel.Dock="Bottom" Margin="8,6,8,2" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <ListBox x:Name="SettingsSearchResults"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     PreviewMouseLeftButtonUp="SettingsSearchResults_PreviewMouseLeftButtonUp"
                                     PreviewKeyDown="SettingsSearchBox_PreviewKeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Top" Margin="10,1,0,0" Padding="6,1" CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>

            <ui:NavigationFluent x:Name="RootNavigation" Grid.Row="1" Grid.Column="0" Width="206" Margin="0,0,10,0" Template="{StaticResource NarrowNavigationFluent}" Frame="{Binding ElementName=RootFrame}" SelectedPageIndex="0">
                <ui:NavigationFluent.Items>

                    <ui:NavigationHeader x:Name="PinnedHeader" Text="{x:Static resources:Strings.Menu_MainWindow_Pinned}" Icon="Pin24" Visibility="Collapsed" />

                    <ui:NavigationItem Content="Games" PageType="{x:Type pages:HomePage}" Icon="Games24" PageTag="games" />
                    <ui:NavigationItem Content="People" PageType="{x:Type pages:PeoplePage}" Icon="People24" PageTag="people" />
                    <ui:NavigationItem Content="Performance" PageType="{x:Type pages:PerformancePage}" Icon="Gauge24" PageTag="performance" />
                    <ui:NavigationItem Content="FastFlags" PageType="{x:Type pages:FastFlagSettingsPage}" Icon="Flag24" PageTag="fastflagsettings" />
                    <ui:NavigationItem Content="Capture" PageType="{x:Type pages:CapturePage}" Icon="Camera24" PageTag="capture" />
                    <ui:NavigationItem Content="Launching" PageType="{x:Type pages:LaunchingPage}" Icon="PlaySettings20" PageTag="launching" />
                    <ui:NavigationItem Content="Look and feel" PageType="{x:Type pages:LookAndFeelPage}" Icon="PaintBrush24" PageTag="lookandfeel" />
                    <ui:NavigationItem Content="PhasmaStrap" PageType="{x:Type pages:AppPage}" Icon="Settings24" PageTag="phasmastrap" />
                </ui:NavigationFluent.Items>
                <ui:NavigationFluent.Footer>

                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Icon="QuestionCircle48" Margin="0,0,0,12" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
                </ui:NavigationFluent.Footer>
            </ui:NavigationFluent>

            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:Breadcrumb x:Name="RootBreadcrumb" Grid.Row="0" Margin="0,0,0,5" Navigation="{Binding ElementName=RootNavigation}" FontFamily="{DynamicResource PhasmaDisplay}" />
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </Grid>

        <StatusBar x:Name="RootStatusBar" Grid.Row="2" Padding="14,10" BorderThickness="0,1,0,0">
            <StatusBar.Background>
                <SolidColorBrush Color="{ui:ThemeResource ApplicationBackgroundColor}" Opacity="0" />
            </StatusBar.Background>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
                    <TextBlock Padding="12,0,0,0" Text="{x:Static resources:Strings.Menu_TestMode}" VerticalAlignment="Center" FontSize="14" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Padding="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Settings_SaveAndLaunch}" Appearance="Primary" Command="{Binding SaveAndLaunchCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}" Appearance="Primary" Command="{Binding SaveSettingsCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="4" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Settings_Restart}" Command="{Binding RestartCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="5" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneWay}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:WpfUiWindow>
