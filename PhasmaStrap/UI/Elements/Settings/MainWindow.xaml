<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:PhasmaStrap.Resources"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="1000"
             Width="1116"
             Height="638"
             ExtendsContentIntoTitleBar="True"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed"
             Loaded="MainWindow_MistLoaded">

    <Window.Resources>
        <BlurEffect x:Key="MistBlurLarge" Radius="70" />

        <Storyboard x:Key="MistDrift" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="X"
                From="-80" To="100" Duration="0:0:14" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="Y"
                From="30" To="-40" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="X"
                From="90" To="-110" Duration="0:0:16" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="Y"
                From="-40" To="35" Duration="0:0:12.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  drifting red mist behind the glass, matches the bootstrapper splash's style  -->
        <Canvas Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse x:Name="Mist1" Width="480" Height="480" Canvas.Left="-160" Canvas.Top="-200" Opacity="0.12" Effect="{StaticResource MistBlurLarge}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate1" X="-80" Y="30" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8FF4554B" Offset="0" />
                        <GradientStop Color="#00F4554B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Mist2" Width="420" Height="420" Canvas.Left="620" Canvas.Top="120" Opacity="0.15" Effect="{StaticResource MistBlurLarge}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate2" X="90" Y="-40" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#80CF3B32" Offset="0" />
                        <GradientStop Color="#00CF3B32" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Icon="Info20" Timeout="10000" Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="10" />
        
        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Appearance="Success" Icon="CheckmarkCircle32" Timeout="3000" Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.Menu_Title}" Icon="pack://application:,,,/PhasmaStrap.ico" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="12,12,0,0" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:AutoSuggestBox
                x:Name="SettingsSearchBox"
                Grid.Row="0" Grid.Column="0"
                Margin="0,0,12,10"
                PlaceholderText="{x:Static resources:Strings.Menu_Settings_SearchPlaceholder}"
                Icon="Search24"
                MaxDropDownHeight="320"
                SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                KeyDown="SettingsSearchBox_KeyDown" />

            <ui:NavigationFluent x:Name="RootNavigation" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Frame="{Binding ElementName=RootFrame}" SelectedPageIndex="0">
                <ui:NavigationFluent.Items>
                    <!-- The pinned NavigationItems themselves are built dynamically at runtime by
                         MainWindow.xaml.cs's RebuildPinnedGroup(), from Settings.PinnedNavItems - see
                         InitializePinning(). Right-click any item below to pin/unpin it. This header
                         stays a permanent, hidden-when-empty item rather than being inserted/removed
                         itself - wpfui's NavigationBase.OnNavigationCollectionChanged hard-casts every
                         removed item to INavigationItem, which NavigationHeader does not implement, so
                         removing a header from Items throws InvalidCastException. -->
                    <ui:NavigationHeader x:Name="PinnedHeader" Text="Pinned" Icon="Pin24" Visibility="Collapsed" />

                    <ui:NavigationHeader Text="Game &amp; Session" Icon="Games24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Title}" PageType="{x:Type pages:IntegrationsPage}" Icon="Add28" PageTag="integrations" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_ServerBrowser_Title}" PageType="{x:Type pages:ServerBrowserPage}" Icon="Server24" PageTag="serverbrowser" />
                    <ui:NavigationItem Content="History" PageType="{x:Type pages:HistoryPage}" Icon="History24" PageTag="history" />
                    <ui:NavigationItem Content="Channel" PageType="{x:Type pages:ChannelPage}" Icon="ArrowRepeatAll24" PageTag="channel" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_ClassicClient_Title}" PageType="{x:Type pages:ClassicClientPage}" Icon="Clock24" PageTag="classicclient" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_GameChat_Title}" PageType="{x:Type pages:GameChatPage}" Icon="Chat24" PageTag="gamechat" />

                    <ui:NavigationHeader Text="Performance" Icon="Gauge24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlags_Title}" PageType="{x:Type pages:FastFlagsPage}" Icon="Flag24" PageTag="fastflags" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlagProfiles_Title}" PageType="{x:Type pages:FastFlagProfilesPage}" Icon="Games24" PageTag="fastflagprofiles" />
                    <ui:NavigationItem Content="Performance" PageType="{x:Type pages:PerformancePage}" Icon="Gauge24" PageTag="performance" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Nvidia_Title}" PageType="{x:Type pages:NvidiaPage}" Icon="TopSpeed24" PageTag="nvidia" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Overlays_Title}" PageType="{x:Type pages:OverlaysPage}" Icon="Layer24" PageTag="overlays" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_RiShade_Title}" PageType="{x:Type pages:RiShadePage}" Icon="Sparkle24" PageTag="rishade" />

                    <ui:NavigationHeader Text="Network" Icon="Globe24" />
                    <ui:NavigationItem Content="Networking" PageType="{x:Type pages:NetworkingPage}" Icon="Globe24" PageTag="networking" />

                    <ui:NavigationHeader Text="Customization" Icon="PaintBrush24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Mods_Title}" PageType="{x:Type pages:ModsPage}" Icon="WrenchScrewdriver20" PageTag="mods" />
                    <ui:NavigationItem Content="Extensions" PageType="{x:Type pages:ExtensionsPage}" Icon="PuzzleCube24" PageTag="extensions" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" Icon="PaintBrush24" PageTag="appearance" />

                    <ui:NavigationHeader Text="System" Icon="Settings24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Behaviour_Title}" PageType="{x:Type pages:BehaviourPage}" Icon="PlaySettings20" PageTag="bootstrapper" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Common_Shortcuts}" PageType="{x:Type pages:ShortcutsPage}" Icon="Apps28" PageTag="shortcuts" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Notifications_Title}" PageType="{x:Type pages:NotificationsPage}" Icon="Alert24" PageTag="notifications" />

                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" PageType="{x:Type pages:FastFlagEditorPage}" PageTag="fastflageditor" Visibility="Collapsed" />
                </ui:NavigationFluent.Items>
                <ui:NavigationFluent.Footer>
                    <ui:NavigationItem Content="PhasmaStrap" PageType="{x:Type pages:PhasmaStrapPage}" Icon="Settings24" Tag="shortcuts" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Icon="QuestionCircle48" Margin="0,0,0,12" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
                </ui:NavigationFluent.Footer>
            </ui:NavigationFluent>

            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:Breadcrumb Grid.Row="0" Margin="0,0,0,5" Navigation="{Binding ElementName=RootNavigation}" FontFamily="{DynamicResource PhasmaDisplay}" />
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </Grid>

        <StatusBar x:Name="RootStatusBar" Grid.Row="2" Padding="14,10" BorderThickness="0,1,0,0">
            <StatusBar.Background>
                <SolidColorBrush Color="{ui:ThemeResource ApplicationBackgroundColor}" Opacity="0" />
            </StatusBar.Background>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
                    <TextBlock Padding="12,0,0,0" Text="{x:Static resources:Strings.Menu_TestMode}" VerticalAlignment="Center" FontSize="14" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Padding="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Settings_SaveAndLaunch}" Appearance="Primary" Command="{Binding SaveAndLaunchCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}" Appearance="Primary" Command="{Binding SaveSettingsCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="4" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Settings_Restart}" Command="{Binding RestartCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="5" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneWay}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:WpfUiWindow>
