<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
             xmlns:installerpages="clr-namespace:PhasmaStrap.UI.Elements.Installer.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:PhasmaStrap.Resources"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="1000"
             Width="1116"
             Height="638"
             ExtendsContentIntoTitleBar="True"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed"
             Loaded="MainWindow_MistLoaded">

    <Window.Resources>
        <BlurEffect x:Key="MistBlurLarge" Radius="70" />

        <Storyboard x:Key="MistDrift" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="X"
                From="-80" To="100" Duration="0:0:14" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="Y"
                From="30" To="-40" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="X"
                From="90" To="-110" Duration="0:0:16" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="Y"
                From="-40" To="35" Duration="0:0:12.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  drifting mist behind the glass, matches the bootstrapper splash's style. The colour comes
              from the theme (BackgroundGlow*Brush) so a custom colour theme can change it; the soft
              falloff is an opacity mask rather than a gradient fill, so it works for any colour  -->
        <Canvas Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse x:Name="Mist1" Width="480" Height="480" Canvas.Left="-160" Canvas.Top="-200" Opacity="0.12" Effect="{StaticResource MistBlurLarge}" Fill="{DynamicResource BackgroundGlowPrimaryBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate1" X="-80" Y="30" />
                </Ellipse.RenderTransform>
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#8F000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
            <Ellipse x:Name="Mist2" Width="420" Height="420" Canvas.Left="620" Canvas.Top="120" Opacity="0.15" Effect="{StaticResource MistBlurLarge}" Fill="{DynamicResource BackgroundGlowSecondaryBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate2" X="90" Y="-40" />
                </Ellipse.RenderTransform>
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
        </Canvas>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Icon="Info20" Timeout="10000" Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="10" />
        
        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Appearance="Success" Icon="CheckmarkCircle32" Timeout="3000" Margin="200,0,200,84" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.Menu_Title}" Icon="pack://application:,,,/PhasmaStrap.ico" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="12,12,0,0" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- themable panel behind the sidebar (search box + navigation); transparent unless a custom
                 colour theme sets SidebarBackgroundBrush -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="-6,-6,6,8" CornerRadius="10"
                    Background="{DynamicResource SidebarBackgroundBrush}" IsHitTestVisible="False" />

            <!-- Settings search: every option/group/tab/section on every page is indexed (generated
                 from the pages' XAML - see tools/gen_settings_search_index.py). Results open in the
                 popup below; choosing one navigates, switches tab, expands the group and highlights
                 the exact control. Ctrl+F / Ctrl+K focuses the box from anywhere in the window. -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                <ui:TextBox
                    x:Name="SettingsSearchBox"
                    PlaceholderText="{x:Static resources:Strings.Menu_Settings_SearchPlaceholder}"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    TextChanged="SettingsSearchBox_TextChanged"
                    PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"
                    GotKeyboardFocus="SettingsSearchBox_GotKeyboardFocus"
                    LostKeyboardFocus="SettingsSearchBox_LostKeyboardFocus" />

                <Popup x:Name="SettingsSearchPopup"
                       PlacementTarget="{Binding ElementName=SettingsSearchBox}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Focusable="False">
                    <Border Width="480" MaxHeight="440" Margin="0,0,8,8"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
                        </Border.Effect>
                        <DockPanel>
                            <TextBlock x:Name="SettingsSearchFooter" DockPanel.Dock="Bottom" Margin="8,6,8,2" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <ListBox x:Name="SettingsSearchResults"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     PreviewMouseLeftButtonUp="SettingsSearchResults_PreviewMouseLeftButtonUp"
                                     PreviewKeyDown="SettingsSearchBox_PreviewKeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Top" Margin="10,1,0,0" Padding="6,1" CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>

            <ui:NavigationFluent x:Name="RootNavigation" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Frame="{Binding ElementName=RootFrame}" SelectedPageIndex="0">
                <ui:NavigationFluent.Items>
                    <!-- The pinned NavigationItems themselves are built dynamically at runtime by
                         MainWindow.xaml.cs's RebuildPinnedGroup(), from Settings.PinnedNavItems - see
                         InitializePinning(). Right-click any item below to pin/unpin it. This header
                         stays a permanent, hidden-when-empty item rather than being inserted/removed
                         itself - wpfui's NavigationBase.OnNavigationCollectionChanged hard-casts every
                         removed item to INavigationItem, which NavigationHeader does not implement, so
                         removing a header from Items throws InvalidCastException. -->
                    <ui:NavigationHeader x:Name="PinnedHeader" Text="{x:Static resources:Strings.Menu_MainWindow_Pinned}" Icon="Pin24" Visibility="Collapsed" />

                    <!-- Matches Voidstrap's own sidebar grouping/order/labels where PhasmaStrap has
                         a real equivalent page (Deployment=Behaviour, Global=GBS Editor, News=Releases,
                         Settings=Channel - label only, PageTag/underlying page unchanged so pinned
                         items and search results still resolve). Core and Configuration each hold
                         exactly Voidstrap's own item count/order - nothing extra gets mixed in, so
                         those two sections stay the same short length as the screenshot. PhasmaStrap's
                         own additional pages (things Voidstrap doesn't have) get two headers of their
                         own instead of being crammed into Core/Configuration: "Session" for
                         gameplay/session tools, "Advanced" for technical/tuning pages. -->
                    <ui:NavigationHeader Text="{x:Static resources:Strings.Menu_MainWindow_Core}" Icon="Home24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Home_Home}" PageType="{x:Type pages:HomePage}" Icon="Home24" PageTag="home" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" Icon="PaintBrush24" PageTag="appearance" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Title}" PageType="{x:Type pages:IntegrationsPage}" Icon="Add28" PageTag="integrations" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Behaviour_Title}" PageType="{x:Type pages:BehaviourPage}" Icon="PlaySettings20" PageTag="bootstrapper" />

                    <ui:NavigationHeader Text="{x:Static resources:Strings.Menu_MainWindow_Session}" Icon="Play24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_ServerBrowser_Title}" PageType="{x:Type pages:ServerBrowserPage}" Icon="Server24" PageTag="serverbrowser" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_ClassicClient_Title}" PageType="{x:Type pages:ClassicClientPage}" Icon="Clock24" PageTag="classicclient" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Capture_Capture}" PageType="{x:Type pages:CapturePage}" Icon="Camera24" PageTag="capture" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Accounts_Accounts}" PageType="{x:Type pages:AccountsPage}" Icon="PersonAccounts24" PageTag="accounts" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Friends_Friends}" PageType="{x:Type pages:FriendsPage}" Icon="People24" PageTag="friends" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Tabs_Activity}" PageType="{x:Type pages:ActivityPage}" Icon="Timeline24" PageTag="activity" />

                    <ui:NavigationHeader Text="{x:Static resources:Strings.Menu_MainWindow_Configuration}" Icon="Settings24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlagSettings_Title}" PageType="{x:Type pages:FastFlagSettingsPage}" Icon="Flag24" PageTag="fastflagsettings" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Mods_Title}" PageType="{x:Type pages:ModsPage}" Icon="WrenchScrewdriver20" PageTag="mods" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_GBSEditor_Title}" PageType="{x:Type pages:GBSEditorPage}" Icon="Globe24" PageTag="gbseditor" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Releases_Title}" PageType="{x:Type pages:ReleasesPage}" Icon="DocumentBulletList24" PageTag="releases" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Manager_Title}" PageType="{x:Type installerpages:ManagerPage}" Icon="ArrowDownload24" PageTag="manager" />

                    <ui:NavigationHeader Text="{x:Static resources:Strings.Menu_GBSEditor_Tab_Advanced}" Icon="Wrench24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlags_Section_Rendering}" PageType="{x:Type pages:RenderingPage}" Icon="Gauge24" PageTag="rendering" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Notifications_Title}" PageType="{x:Type pages:NotificationsPage}" Icon="Alert24" PageTag="notifications" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlags_Section_Networking}" PageType="{x:Type pages:NetworkingPage}" Icon="Globe24" PageTag="networking" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Hotkeys_Hotkeys}" PageType="{x:Type pages:HotkeysPage}" Icon="Keyboard24" PageTag="hotkeys" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_DeveloperTools_DeveloperTools}" PageType="{x:Type pages:DeveloperToolsPage}" Icon="Code24" PageTag="developertools" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_PhasmaStrap_Section_Diagnostics_Header}" PageType="{x:Type pages:DiagnosticsPage}" Icon="Stethoscope24" PageTag="diagnostics" />
                </ui:NavigationFluent.Items>
                <ui:NavigationFluent.Footer>
                    <!-- Footer isn't pinned to the bottom of the window in this narrow sidebar - it
                         just continues straight on from Items once the list overflows, so it needs its
                         own header here to read as a separate group rather than more Advanced items. -->
                    <ui:NavigationHeader Text="{x:Static resources:Strings.Menu_MainWindow_App}" Icon="Apps24" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Common_Shortcuts}" PageType="{x:Type pages:ShortcutsPage}" Icon="Apps28" PageTag="shortcuts" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_PhasmaStrap_PhasmaStrap}" PageType="{x:Type pages:PhasmaStrapPage}" Icon="Settings24" PageTag="phasmastrap" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Icon="QuestionCircle48" Margin="0,0,0,12" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
                </ui:NavigationFluent.Footer>
            </ui:NavigationFluent>

            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:Breadcrumb Grid.Row="0" Margin="0,0,0,5" Navigation="{Binding ElementName=RootNavigation}" FontFamily="{DynamicResource PhasmaDisplay}" />
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </Grid>

        <StatusBar x:Name="RootStatusBar" Grid.Row="2" Padding="14,10" BorderThickness="0,1,0,0">
            <StatusBar.Background>
                <SolidColorBrush Color="{ui:ThemeResource ApplicationBackgroundColor}" Opacity="0" />
            </StatusBar.Background>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
                    <TextBlock Padding="12,0,0,0" Text="{x:Static resources:Strings.Menu_TestMode}" VerticalAlignment="Center" FontSize="14" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Padding="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Settings_SaveAndLaunch}" Appearance="Primary" Command="{Binding SaveAndLaunchCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}" Appearance="Primary" Command="{Binding SaveSettingsCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="4" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Settings_Restart}" Command="{Binding RestartCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="5" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneWay}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:WpfUiWindow>
