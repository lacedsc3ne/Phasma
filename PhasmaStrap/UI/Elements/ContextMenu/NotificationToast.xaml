<Window x:Class="PhasmaStrap.UI.Elements.ContextMenu.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="448"
        SizeToContent="Height"
        MaxHeight="340"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="14,10,14,18">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" X="440" Y="0" />
        </Grid.RenderTransform>

        <StackPanel x:Name="NotificationBorder" Opacity="0">

            <Grid x:Name="StackHeader" Margin="2,0,2,7" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StackCountText" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="2 NOTIFICATIONS" />

                <ui:Button Grid.Column="1" Padding="9,2" FontSize="11" Appearance="Secondary" Content="Clear all" Click="ClearAllButton_Click" />
            </Grid>

            <Border x:Name="PeekFar" Width="396" Height="7" HorizontalAlignment="Center" CornerRadius="7,7,0,0" Visibility="Collapsed"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderThickness="1,1,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Border x:Name="PeekNear" Width="410" Height="7" HorizontalAlignment="Center" CornerRadius="7,7,0,0" Visibility="Collapsed"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1,1,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Border x:Name="CardBorder" CornerRadius="10" MouseLeftButtonUp="NotificationBorder_MouseLeftButtonUp"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.42" BlurRadius="24" ShadowDepth="6" Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="13,12,12,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Margin="0,1,11,0" VerticalAlignment="Top">
                            <Border.Background>
                                <SolidColorBrush x:Name="IconBackground" Color="{DynamicResource SystemAccentColorPrimary}" Opacity="0.16" />
                            </Border.Background>
                            <ui:SymbolIcon x:Name="CategoryIcon" Symbol="Info24" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13.5"
                                       TextWrapping="Wrap" LineHeight="17" />
                            <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" LineHeight="16"
                                       TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="150" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HintText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,4,0,0"
                                       Visibility="Collapsed" Text="Click to open" />
                            <ui:Button x:Name="ActionButton" Margin="0,9,0,0" Padding="11,4" HorizontalAlignment="Left" Appearance="Secondary" Icon="Edit16"
                                       FontSize="12" Visibility="Collapsed" Click="ActionButton_Click" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Padding="3" Appearance="Transparent" Icon="Dismiss16" VerticalAlignment="Top" Margin="8,-3,-4,0" Click="CloseButton_Click" />
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="0,0,10,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid HorizontalAlignment="Stretch">
                            <Rectangle x:Name="ProgressBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="2"
                                       RenderTransformOrigin="0,0.5" Fill="{DynamicResource SystemAccentColorPrimaryBrush}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
