<Window x:Class="PhasmaStrap.UI.Elements.ContextMenu.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="340"
        Height="92"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid Margin="6,6,6,8">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" X="360" Y="0" />
        </Grid.RenderTransform>
        <Border x:Name="NotificationBorder" CornerRadius="10" Padding="0" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
                    <GradientStop Offset="0.7" Color="{DynamicResource WindowBackgroundColorSecondary}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorThird}" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" RadiusX="2.5" RadiusY="2.5" Margin="0,8,0,8" HorizontalAlignment="Stretch">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorPrimary}" />
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Grid.Column="1" Margin="12,10,14,10" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="20" />
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,0" />
                    <Border Margin="0,8,0,0" CornerRadius="2" Height="3" Background="#22FFFFFF" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="ProgressBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="3" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorPrimary}" />
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
