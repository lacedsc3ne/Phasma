<Window x:Class="PhasmaStrap.UI.Elements.ContextMenu.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="360"
        Height="98"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid Margin="10,10,10,14">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" X="380" Y="0" />
        </Grid.RenderTransform>
        <Border x:Name="NotificationBorder" CornerRadius="12" Padding="0" Opacity="0" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="22" ShadowDepth="6" Direction="270" />
            </Border.Effect>
            <Grid Margin="14,12,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top" Margin="0,1,12,0">
                    <Ellipse x:Name="CategoryBadge" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Opacity="0.16" />
                    <ui:SymbolIcon x:Name="CategoryIcon" Symbol="Info24" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="20" />
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,0" />
                    <Border Margin="0,8,0,0" CornerRadius="2" Height="3" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="ProgressBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="3" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5"
                                       Fill="{DynamicResource SystemAccentColorPrimaryBrush}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                </StackPanel>

                <ui:Button Grid.Column="2" Padding="4" Appearance="Transparent" Icon="Dismiss16" VerticalAlignment="Top" Margin="6,-2,-2,0" Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
