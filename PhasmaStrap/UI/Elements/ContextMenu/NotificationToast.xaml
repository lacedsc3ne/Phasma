<Window x:Class="PhasmaStrap.UI.Elements.ContextMenu.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="420"
        SizeToContent="Height"
        MaxHeight="300"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- Height follows the content (title/message wrap, nothing is clipped); the outer margin
         leaves room for the shadow. -->
    <Grid Margin="12,10,12,18">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" X="440" Y="0" />
        </Grid.RenderTransform>
        <Border x:Name="NotificationBorder" CornerRadius="12" Opacity="0" MouseLeftButtonUp="NotificationBorder_MouseLeftButtonUp"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                ClipToBounds="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="24" ShadowDepth="6" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- category accent stripe -->
                <Border x:Name="AccentBar" Grid.Column="0" Width="5" CornerRadius="12,0,0,12" Background="{DynamicResource SystemAccentColorPrimaryBrush}" />

                <Grid Grid.Column="1" Margin="14,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Border.Background>
                                <SolidColorBrush x:Name="IconBackground" Color="{DynamicResource SystemAccentColorPrimary}" Opacity="0.18" />
                            </Border.Background>
                            <ui:SymbolIcon x:Name="CategoryIcon" Symbol="Info24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinHeight="32">
                            <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="14"
                                       TextWrapping="Wrap" LineHeight="18" />
                            <TextBlock x:Name="SourceText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Text="PhasmaStrap" Margin="0,1,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Padding="5" Appearance="Transparent" Icon="Dismiss16" VerticalAlignment="Top" Margin="8,-4,-4,0" Click="CloseButton_Click" />
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="MessageText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" LineHeight="17"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="170" TextTrimming="CharacterEllipsis" />

                    <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="2" Height="3" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="ProgressBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="3" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5"
                                       Fill="{DynamicResource SystemAccentColorPrimaryBrush}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
