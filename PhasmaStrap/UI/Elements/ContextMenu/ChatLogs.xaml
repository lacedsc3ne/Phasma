<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.ContextMenu.ChatLogs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.ContextMenu"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels.ContextMenu"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        d:DataContext="{d:DesignInstance Type=models:ChatLogsViewModel}"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.ContextMenu_ChatLogs_Title}"
        MinWidth="480"
        MinHeight="360"
        Width="640"
        Height="480"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Padding="8" x:Name="RootTitleBar" Title="{x:Static resources:Strings.ContextMenu_ChatLogs_Title}" ShowMinimize="True" ShowMaximize="True" CanMaximize="True" KeyboardNavigation.TabNavigation="None" Icon="pack://application:,,,/PhasmaStrap.ico" />

        <TextBlock Grid.Row="1" Margin="16,8,16,0" Text="{x:Static resources:Strings.ContextMenu_ChatLogs_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Grid.Row="2" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static resources:Strings.ContextMenu_ChatLogs_Placeholder}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasEntries, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Visible" />
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Name="ChatLogsDataGrid" Grid.Row="2" Margin="16,8,16,8" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True" ItemsSource="{Binding MessageLogsCollection}">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasEntries, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Width="140" Header="{x:Static resources:Strings.ContextMenu_ChatLogs_ColumnTime}" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" />
                <DataGridTextColumn Width="120" Header="{x:Static resources:Strings.ContextMenu_ChatLogs_ColumnChannel}" Binding="{Binding Channel}" />
                <DataGridTextColumn Width="140" Header="{x:Static resources:Strings.ContextMenu_ChatLogs_ColumnSender}" Binding="{Binding Sender}" />
                <DataGridTextColumn Width="*" Header="{x:Static resources:Strings.ContextMenu_ChatLogs_ColumnMessage}" Binding="{Binding Message}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button MinWidth="100" Content="{x:Static resources:Strings.Common_Export}" Command="{Binding ExportCommand, Mode=OneTime}" />
                <Button Margin="12,0,0,0" MinWidth="100" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneTime}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
