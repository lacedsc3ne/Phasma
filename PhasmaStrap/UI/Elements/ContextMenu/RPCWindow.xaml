<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.ContextMenu.RPCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.ContextMenu"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels.ContextMenu"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        d:DataContext="{d:DesignInstance Type=models:RPCWindowViewModel}"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.ContextMenu_RPCWindow_Title}"
        MinWidth="480"
        MinHeight="420"
        Width="560"
        Height="600"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" x:Name="RootTitleBar" Title="{x:Static resources:Strings.ContextMenu_RPCWindow_Title}" ShowMinimize="True" ShowMaximize="True" CanMaximize="True" KeyboardNavigation.TabNavigation="None" Icon="pack://application:,,,/PhasmaStrap.ico" />

        <TextBlock Grid.Row="1" Margin="16,8,16,0" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="2">
            <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Placeholder}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="16,8,16,8">
                    <ui:Card Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Details}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,2,0,10" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_State}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding State}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Images}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_LargeImageKey}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding LargeImageKey}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_LargeImageText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding LargeImageText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_SmallImageKey}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SmallImageKey}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_SmallImageText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SmallImageText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Timestamps}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_TimestampStart}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TimestampStart}" Margin="0,0,0,6" />
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_TimestampEnd}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TimestampEnd}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Buttons}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Buttons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding Url, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_NoButtons}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasButtons, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Static resources:Strings.ContextMenu_RPCWindow_LastUpdated}" />
                    <Run Text=" " />
                    <Run Text="{Binding LastUpdated, Mode=OneWay}" />
                </TextBlock>
                <Button Grid.Column="1" MinWidth="100" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneTime}" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
