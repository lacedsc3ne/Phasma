<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.ContextMenu.AppColorThemeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Title}"
    Width="1080"
    Height="720"
    MinWidth="820"
    MinHeight="560"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Closed="AppColorThemeEditor_Closed"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            Padding="8"
            Title="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Title}"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            MinimizeToTray="False"
            ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="16,6,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="300" />
                <ColumnDefinition x:Name="PreviewGap" Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="PreviewPane"
                Grid.Column="0"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewHeading}" />
                        <Border
                            Margin="0,10,0,0"
                            Padding="14"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewPanelSurface}" />
                                <TextBlock
                                    Margin="0,2,0,12"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewSecondaryText}"
                                    TextWrapping="Wrap" />
                                <ui:Button
                                    HorizontalAlignment="Left"
                                    Appearance="Primary"
                                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewButton}" />
                                <ui:ToggleSwitch
                                    Margin="0,12,0,0"
                                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewToggleItem}"
                                    IsChecked="True" />
                                <ComboBox Margin="0,12,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewDropdownItem}" />
                                    <ComboBoxItem Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewDropdownItem2}" />
                                </ComboBox>
                                <Border
                                    Margin="0,12,0,0"
                                    Padding="8"
                                    Background="{DynamicResource NewTextEditorBackground}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource NewTextEditorForeground}"
                                            Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewEditorText}" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource NewTextEditorLink}"
                                            Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PreviewEditorLink}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl
                x:Name="EditorTabs"
                Grid.Column="2"
                Background="#00FFFFFF"
                BorderThickness="0"
                SelectionChanged="EditorTabs_SelectionChanged">
                <TabItem x:Name="ColoursTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Color24" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_ColoursTab}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Border
                        Margin="0,10,0,0"
                        Background="{DynamicResource ControlSolidFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ColorList">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,10,0,6"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Name}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Label}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ui:TextBox
                                                Grid.Column="1"
                                                Margin="6,0"
                                                FontFamily="Consolas"
                                                Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="2"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Click="Swatch_Click"
                                                ToolTip="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PickColourTooltip}">
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    Background="{Binding Swatch}"
                                                    BorderBrush="#55FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem x:Name="CodeTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Code24" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_CodeTab}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Click="Format_Click"
                                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Format}" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Click="PickColor_Click"
                                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_PickColour}"
                                    Icon="Color24" />
                                <ui:Button
                                    Appearance="Secondary"
                                    Click="CopyCode_Click"
                                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Copy}"
                                    Icon="Copy16" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                x:Name="PreviewToggle"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Checked="PreviewToggle_Changed"
                                Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Preview}"
                                IsChecked="True"
                                Unchecked="PreviewToggle_Changed" />
                        </Grid>
                        <Border
                            Grid.Row="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="6">
                            <avalonedit:TextEditor
                                x:Name="CodeEditor"
                                Padding="8,6"
                                HorizontalScrollBarVisibility="Auto"
                                ShowLineNumbers="True"
                                Style="{StaticResource NewTextEditor}"
                                SyntaxHighlighting="XML"
                                VerticalScrollBarVisibility="Auto"
                                WordWrap="False" />
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border
            x:Name="StatusBorder"
            Grid.Row="2"
            Margin="16,10,16,0"
            Padding="12,8"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="StatusIcon"
                    Margin="0,0,8,0"
                    VerticalAlignment="Top"
                    Symbol="Warning24" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Padding="16,10"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid>
                <ui:Button
                    HorizontalAlignment="Left"
                    Appearance="Secondary"
                    Click="Reset_Click"
                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_ResetToDefault}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="SaveButton"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="Save_Click"
                        Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Save}" />
                    <ui:Button
                        Appearance="Secondary"
                        Click="Close_Click"
                        Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_Close}"
                        IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
