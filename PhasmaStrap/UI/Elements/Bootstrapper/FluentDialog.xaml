<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Bootstrapper.FluentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:PhasmaStrap.UI.ViewModels.Bootstrapper"
    Width="500"
    Height="280"
    MinHeight="0"
    d:DataContext="{d:DesignInstance vms:FluentDialogViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="Transparent"
    Closing="UiWindow_Closing"
    Loaded="FluentDialog_Loaded"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="{Binding Path=WindowBackdropType, Mode=OneTime}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <BlurEffect x:Key="MistBlur" Radius="45" />

        <Storyboard x:Key="WindowEntrance">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.7" To="1" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.7" To="1" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="6" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootTranslate"
                Storyboard.TargetProperty="Y"
                From="36" To="0" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoEntrance" BeginTime="0:0:0.1">
            <DoubleAnimation
                Storyboard.TargetName="LogoImage"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.5" />
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.3" To="1" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.3" To="1" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoRotate"
                Storyboard.TargetProperty="Angle"
                From="-25" To="0" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  continuous "still working" motion while Roblox loads: logo breathes, glow pulses, ring spins  -->
        <Storyboard x:Key="LogoBreathe" BeginTime="0:0:0.95" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="LogoBreathScale"
                Storyboard.TargetProperty="ScaleX"
                From="1" To="1.07" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoBreathScale"
                Storyboard.TargetProperty="ScaleY"
                From="1" To="1.07" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoGlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="LogoGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.35" To="0.9" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  slow-drifting red mist blobs behind the glass, three independent loops so it never looks mechanical  -->
        <Storyboard x:Key="MistDrift" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="X"
                From="-60" To="90" Duration="0:0:9" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate1"
                Storyboard.TargetProperty="Y"
                From="20" To="-30" Duration="0:0:7" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="X"
                From="70" To="-90" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MistTranslate2"
                Storyboard.TargetProperty="Y"
                From="-25" To="25" Duration="0:0:8.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="MistTranslate3"
                Storyboard.TargetProperty="X"
                From="-40" To="50" Duration="0:0:13" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Mist1"
                Storyboard.TargetProperty="Opacity"
                From="0.18" To="0.4" Duration="0:0:5.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Mist2"
                Storyboard.TargetProperty="Opacity"
                From="0.35" To="0.15" Duration="0:0:6.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>

    <!--  Background is for Aero theme only  -->
    <Grid x:Name="RootGrid" Background="{Binding Path=BackgroundColourBrush, Mode=OneTime}" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" CenterX="250" CenterY="140" ScaleX="0.7" ScaleY="0.7" />
                <TranslateTransform x:Name="RootTranslate" Y="36" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!--  drifting red mist, clipped to the window bounds, sits behind the frosted glass tint  -->
        <Canvas ClipToBounds="True">
            <Ellipse x:Name="Mist1" Width="320" Height="320" Canvas.Left="-100" Canvas.Top="-120" Opacity="0.25" Effect="{StaticResource MistBlur}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate1" X="-60" Y="20" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8FF4554B" Offset="0" />
                        <GradientStop Color="#00F4554B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Mist2" Width="280" Height="280" Canvas.Left="260" Canvas.Top="-60" Opacity="0.3" Effect="{StaticResource MistBlur}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate2" X="70" Y="-25" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#80CF3B32" Offset="0" />
                        <GradientStop Color="#00CF3B32" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Mist3" Width="240" Height="240" Canvas.Left="90" Canvas.Top="60" Opacity="0.2" Effect="{StaticResource MistBlur}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate3" X="-40" Y="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#66FF6F66" Offset="0" />
                        <GradientStop Color="#00FF6F66" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!--  Allow for drag  -->
        <ui:TitleBar
            VerticalAlignment="Top"
            CanMaximize="False"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Margin="32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="110" Height="110">
                <Ellipse x:Name="LogoGlow" Width="110" Height="110" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4DF4554B" Offset="0" />
                            <GradientStop Color="#00F4554B" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Image
                    x:Name="LogoImage"
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon, Mode=OneWay}"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.3" ScaleY="0.3" />
                            <ScaleTransform x:Name="LogoBreathScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="LogoRotate" Angle="-25" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Message, Mode=OneWay}"
                TextWrapping="Wrap" />

            <ProgressBar
                Grid.Row="2"
                Margin="0,0,0,16"
                IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                Value="{Binding ProgressValue, Mode=OneWay}" />

            <Button
                Grid.Row="3"
                Width="120"
                Padding="4"
                HorizontalAlignment="Center"
                Command="{Binding CancelInstallCommand}"
                Content="{x:Static resources:Strings.Common_Cancel}"
                FontSize="14"
                IsEnabled="{Binding CancelEnabled, Mode=OneWay}" />
        </Grid>
    </Grid>
</base:WpfUiWindow>
