<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.CopyFlagsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_CopyFlags_Title}"
        Width="390"
        MinHeight="0"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="{x:Static resources:Strings.Dialog_CopyFlags_Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Margin="20,12" MaxWidth="350" HorizontalAlignment="Left">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static resources:Strings.Dialog_CopyFlags_Title}" />
            <TextBlock x:Name="CountText" Margin="0,6,0,12" TextWrapping="Wrap" />
            <ComboBox x:Name="FormatBox" MinWidth="200" SelectedIndex="0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" MinWidth="120" Content="{x:Static resources:Strings.Common_Copy}" Click="Copy_Click" />
                <Button MinWidth="100" Margin="12,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
