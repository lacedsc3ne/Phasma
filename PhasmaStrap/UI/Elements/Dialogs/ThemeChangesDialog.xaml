<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Dialogs.ThemeChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Title}"
    Width="560"
    MinHeight="0"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Title}"
            Grid.Row="0"
            Padding="8"
            CanMaximize="False"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />

        <TextBlock
            x:Name="SummaryText"
            Grid.Row="1"
            Margin="16,10,16,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="2"
            MaxHeight="360"
            Margin="16,10,16,0"
            Padding="4"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChangesList" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Label}"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    Background="{Binding OldSwatch}"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding HasOld, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="&#8594;" />

                                <Border
                                    Grid.Column="3"
                                    Width="20"
                                    Height="20"
                                    Background="{Binding NewSwatch}"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4" />

                                <TextBlock
                                    Grid.Column="4"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding NewHex}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Padding="15"
            Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel
                HorizontalAlignment="Right"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    MinWidth="100"
                    Click="SaveButton_Click"
                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Save}" />
                <Button
                    MinWidth="100"
                    Margin="12,0,0,0"
                    Click="CancelButton_Click"
                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
