<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.ChannelListsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_ChannelLists_Title}"
        Width="720"
        Height="520"
        MinHeight="360"
        MinWidth="520"
        ResizeMode="CanResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <ui:UiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8,6" Title="{x:Static resources:Strings.Dialog_ChannelLists_Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <TextBlock Grid.Row="1" Margin="16,8,16,6" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Dialog_ChannelLists_Description}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <DataGrid x:Name="ChannelDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      Margin="0"
                      AlternatingRowBackground="#08000000"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                      ItemsSource="{Binding Channels}"
                      RowBackground="{x:Null}"
                      MouseDoubleClick="ChannelDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:Strings.Dialog_ChannelLists_ColumnChannel}" Width="180" Binding="{Binding ChannelName}" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Dialog_ChannelLists_ColumnVersion}" Width="*" Binding="{Binding Version}" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Dialog_ChannelLists_ColumnVersionGuid}" Width="*" Binding="{Binding VersionGuid}" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Opacity="0.85" CornerRadius="4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="10" IsIndeterminate="True" />
                    <TextBlock Text="{x:Static resources:Strings.Dialog_ChannelLists_Loading}" FontSize="13" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="16,12" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Content="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Icon="ArrowSync24" Margin="0,0,10,0" Command="{Binding RefreshCommand}" />
                <ui:Button Appearance="Primary" Content="{x:Static resources:Strings.Dialog_ChannelLists_Select}" Margin="0,0,10,0" Click="SelectButton_Click" />
                <ui:Button Appearance="Secondary" Content="{x:Static resources:Strings.Common_Close}" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
