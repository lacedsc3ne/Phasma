<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.PartyInviteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        Title="Invite to your party"
        Width="460" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Invite to your party" ShowMaximize="False" ShowMinimize="False" />

        <TextBlock Grid.Row="1" Margin="18,4,18,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding Status, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2" Margin="12,0,12,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Friends, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6,0,6,8" Padding="12,10" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,11,0"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border Width="34" Height="34" CornerRadius="17" Background="White" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ui:Button Grid.Column="2" VerticalAlignment="Center" Content="{Binding ButtonText}" IsEnabled="{Binding CanInvite}"
                                           Command="{Binding DataContext.InviteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="18,12,18,16" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Icon="ArrowClockwise24" Content="Refresh" Command="{Binding RefreshCommand}" />
            <ui:Button Margin="8,0,0,0" Content="Close" Appearance="Primary" Click="Close_Click" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>
